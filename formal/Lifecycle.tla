---------------------------- MODULE Lifecycle ----------------------------
(***************************************************************************)
(* Design-level model of the OpenTailcat connect / attach / reconnect /    *)
(* stop lifecycle across the Kotlin service and the Go engine.            *)
(*                                                                         *)
(* This is NOT a proof of the code.  See formal/README.md for the         *)
(* abstraction choices, the action -> file:function mapping, and what is   *)
(* not covered.                                                            *)
(*                                                                         *)
(* The algorithm is written in PlusCal (P-syntax); the TLA+ between the    *)
(* BEGIN/END TRANSLATION markers is generated by `pcal.trans` (check.sh    *)
(* regenerates it).  Edit only the PlusCal and the definitions outside the *)
(* generated block.                                                        *)
(***************************************************************************)
EXTENDS Integers, Sequences, FiniteSets

CONSTANTS
  MaxSess, MaxBr, MaxTun, MaxJobs, MaxInst,   \* finite-model bounds
  MaxFaults, MaxStarts, MaxDisc,              \* environment budgets
  FreshMax,       \* health is fresh while age <= FreshMax ticks (code: 15 s)
  StalePolls,     \* consecutive stale polls before teardown   (code: 3)
  BadBound,       \* asserted bound (ticks) on UI-live-but-unjustified
  UiRaces,        \* TRUE: poll / network-restore read and act in two steps
  EnPump, EnPrepFail, EnAttachFail, EnNet, EnGw, EnDestroy,   \* fault classes
  EnDisc, EnRevoke, EnRestore, EnAlwaysOn,                    \* user / system events
  EnOnDestroy,    \* TRUE: stopSelf() is followed by the system's onDestroy() (matters only with a 2nd Connect)
  EnPoll,         \* FALSE: onEngineConnected starts no poll loop (shrinks liveness models)
  Timed,          \* FALSE: no clock; poll runs freely, health never ages (untimed scenarios)
  GuardJoinNS,    \* TRUE = production: startWithRetry joins pendingNativeStop
  GuardIdentity,  \* TRUE = production: AttachTun re-checks session identity
  GuardMarkFailed, \* TRUE = production: markFailed checks c.sess == sess
  PumpBr,          \* set of bridge ids whose pumps may die (state-space focus)
  SplitCb,         \* TRUE: the pump-death callback runs as its own step (as coded)
  Mutants          \* subset of {"F1","F2","F3a","F3b","F4","F5","F6","F7","N1","N1b","N2","Serial","Dup","Epoch"}:
                   \* each element switches one OLD (pre-fix) behaviour back on.
                   \* {} is the fixed code.

Sess == 1..MaxSess
Br   == 1..MaxBr
Tun  == 1..MaxTun
Jobs == 1..MaxJobs
Inst == 1..MaxInst
SDs  == 101..(100 + MaxInst)      \* launched shutdown() coroutine of an instance
NSs  == 201..(200 + MaxInst)      \* async native stop of an instance
BPs  == 301..(300 + MaxBr)        \* pumps + callback goroutine of a bridge
GCs  == 401..(400 + MaxSess)      \* markFailed's `go closeSession(sess)`
FINs == 501..(500 + MaxInst)      \* Handler.post(finish) of an instance
Callers == Jobs \cup SDs \cup NSs \cup {3000}   \* processes that call into the Go engine

HCap == FreshMax + 1              \* health age saturates one tick past fresh
Min(a, b) == IF a < b THEN a ELSE b

(* --algorithm Lifecycle

variables
  \* ===== Go engine: core-engine/lifecycle.go (TailcatCore, under globalCore.mu)
  eSt   = "STOPPED",   \* STOPPED PREPARING PREPARED ATTACHING RUNNING STOPPING FAILED
  eCur  = 0,           \* globalCore.sess (0 = nil); session identity = object id
  stopping = FALSE,    \* globalCore.stopping
  hAge  = -1,          \* healthUnix: -1 = 0 (cleared), else age in ticks
  disco = "ok",        \* bridge-reported gateway freshness: ok | stale | lost
  nSess = 0,
  sCanc   = [s \in Sess |-> FALSE],   \* sess.ctx cancelled
  sClient = [s \in Sess |-> FALSE],   \* sess.client published
  sBr     = [s \in Sess |-> 0],       \* sess.bridge published (0 = nil)
  sProven = [s \in Sess |-> FALSE],   \* history: reached RUNNING at least once
  sOwner  = [s \in Sess |-> 0],       \* history: the job whose Prepare created the session
  gcPend  = [s \in Sess |-> FALSE],   \* markFailed queued `go closeSession`
  nBr = 0,
  bSt   = [b \in Br |-> "free"],      \* free new up dead stopped
  bCb   = [b \in Br |-> FALSE],       \* onPumpDead callback set
  bSess = [b \in Br |-> 0],
  bTun  = [b \in Br |-> 0],           \* TUN the bridge holds a dup'd fd of
  cbSt  = [b \in Br |-> "none"],      \* pump-dead callback: none chk mark
  \* ===== Go call frames (per calling process)
  ret = [c \in Callers |-> "none"],   \* result of the last Go call
  \* ===== Android / OS
  nTun = 0,
  tunKind     = [t \in Tun |-> "none"],   \* warm (host-only) | routed (0/0, ::/0)
  androidOpen = [t \in Tun |-> FALSE],    \* ParcelFileDescriptor still open
  osCur = 0,                              \* interface the OS currently routes to
  \* ===== Kotlin service: TailcatVpnService (one record per service instance)
  nInst = 0,
  instUp   = [i \in Inst |-> FALSE],
  shut     = [i \in Inst |-> FALSE],      \* shuttingDown
  ep       = [i \in Inst |-> 0],          \* shutdownEpoch (bumped by the shutdown() that wins the CAS)
  vpnIf    = [i \in Inst |-> 0],          \* vpnInterface field (TUN id)
  startJob = [i \in Inst |-> 0],
  sdReq    = [i \in Inst |-> FALSE],      \* serviceScope.launch { shutdown() } pending
  sdGen    = [i \in Inst |-> -1],         \* its startGeneration scope (-1 = unscoped: onRevoke)
  sGen     = [i \in Inst |-> 0],          \* startGeneration: STARTs this instance accepted
  casGen   = [i \in Inst |-> 0],          \* startGeneration seen by the last winning shutdown() CAS
  doneGen  = [i \in Inst |-> 0],          \* finishedGeneration: casGen of the last finish() that ran
  finReq   = [i \in Inst |-> FALSE],      \* Handler.post(finish) pending
  dReq     = [i \in Inst |-> FALSE],      \* onDestroy() (after stopSelf) pending
  nsRun    = [i \in Inst |-> FALSE],      \* async native stop running
  pendNS   = 0,                           \* pendingNativeStop (instance id)
  lastJob  = 0,                           \* companion lastStartJob (any instance)
  \* ===== Kotlin start/reconnect coroutines
  nJob = 0,
  jobOn   = [j \in Jobs |-> FALSE],
  jDone   = [j \in Jobs |-> FALSE],
  jCanc   = [j \in Jobs |-> FALSE],
  jKind   = [j \in Jobs |-> "start"],
  jInst   = [j \in Jobs |-> 1],
  jEp     = [j \in Jobs |-> 0],          \* shutdownEpoch captured when the job was launched
  jRetry  = [j \in Jobs |-> FALSE],
  jPrev   = [j \in Jobs |-> 0],          \* job joined before running (previous?.join())
  jExc    = [j \in Jobs |-> "none"],
  jW      = [j \in Jobs |-> 0],  jWown = [j \in Jobs |-> FALSE],
  jR      = [j \in Jobs |-> 0],  jRown = [j \in Jobs |-> FALSE],
  jSnapSess = [j \in Jobs |-> 0],
  \* ===== TunnelController (UI-facing)
  ui = "DISCONNECTED",    \* DISCONNECTED CONNECTING CONNECTED RECONNECTING DEGRADED
  uiSess = 0,             \* engine session the current live claim came from
  sessLive = FALSE,
  gen = 0,                \* sessionGeneration
  handler = 0,            \* sessionFailureHandler (instance id, 0 = null)
  vpnWanted = FALSE,
  pollOn = FALSE, pollDue = FALSE, pollStale = 0,
  pollGen = 0,            \* generation the current poll loop was started for
  rcH = 0, rcT = FALSE, rcE = FALSE,   \* poll thread: handler read, post-lock tail pending, reconnect pending
  netRestore = FALSE,     \* network-restore coroutine launched
  netGen = 0,             \* generation it captured
  intents = <<>>,         \* onStartCommand queue: USER AUTO AO STOP
  \* ===== environment
  net = "up", gw = "up",
  faults = 0, starts = 0, discs = 0,
  \* ===== history / auxiliary (never read by the system, only by properties)
  badTicks = 0,           \* consecutive ticks UI claimed live without justification
  prepAfterShut = FALSE,  \* a job started Prepare after its instance's shutdown() finished
  staleStop = FALSE,      \* an OLDER job stopped / preempted the session of a YOUNGER job
  boundHit = FALSE;       \* a finite-model bound was reached (model too small)

define
  Mut(m) == m \in Mutants
  \* A startService() call Android has already given a start id but the
  \* instance has not handled yet: stopSelf(lastStartId) then fails.
  PendingStart == \E k \in 1..Len(intents) : intents[k] \in {"USER", "AUTO", "AO", "STOP"}

  Reach == net = "up" /\ gw = "up"
  FreshH(h) == h >= 0 /\ h <= FreshMax
  LiveUi == {"CONNECTED", "DEGRADED"}

  \* getStatsJSON() as the Kotlin side sees it
  Snap == [st    |-> IF stopping THEN "STOPPING" ELSE eSt,
           fresh |-> FreshH(hAge),
           disco |-> disco,
           sess  |-> eCur]
  NoSnap == [st |-> "STOPPED", fresh |-> FALSE, disco |-> "ok", sess |-> 0]
  LiveSnap(s) == s.st = "RUNNING" /\ s.fresh          \* NetworkMetrics.isLiveRunning
  Reason(s) == IF s.st = "FAILED" THEN "pump"         \* EngineHealth.teardownReason
               ELSE IF ~LiveSnap(s) THEN "stale"
               ELSE IF s.disco = "lost" THEN "gw"
               ELSE "ok"

  StopBr(f, b) == IF b = 0 THEN f ELSE [f EXCEPT ![b] = "stopped"]
  CbOff(f, b)  == IF b = 0 THEN f ELSE [f EXCEPT ![b] = FALSE]
  CloseT(f, t) == IF t = 0 THEN f ELSE [f EXCEPT ![t] = FALSE]
  CloseOwned(f, j) == [t \in Tun |-> IF (jWown[j] /\ t = jW[j])
                                        \/ (jRown[j] /\ t = jR[j])
                                     THEN FALSE ELSE f[t]]
  NsDone == IF pendNS = 0 THEN TRUE ELSE ~nsRun[pendNS]   \* pendingNativeStop?.join()
  PrevDone(j) == IF jPrev[j] = 0 THEN TRUE ELSE jDone[jPrev[j]]
  JobActive(j) == IF j = 0 THEN FALSE
                  ELSE jobOn[j] /\ ~jDone[j] /\ ~jCanc[j]   \* Job.isActive
  AbandonAttach == IF eCur # 0 /\ eSt \in {"ATTACHING", "PREPARED"}
                   THEN "PREPARED" ELSE eSt

  \* isStale(epoch) = shuttingDown || shutdownEpoch != epoch   (Epoch mutant: shuttingDown only)
  Stale(j) == shut[jInst[j]] \/ (~Mut("Epoch") /\ ep[jInst[j]] # jEp[j])
  \* ensureActive(); checkNotShuttingDown(epoch)
  Cancelled(j) == jCanc[j] \/ Stale(j)

  HeartbeatAlive == /\ eCur # 0
                    /\ sBr[eCur] # 0
                    /\ bSt[sBr[eCur]] = "up"
  NextH == IF HeartbeatAlive THEN 0
           ELSE IF hAge < 0 THEN -1 ELSE Min(hAge + 1, HCap)
  NextDisco == IF Reach THEN "ok"
               ELSE IF disco = "ok" THEN "stale" ELSE "lost"

  \* Is some service instance mid-shutdown (UI is allowed to lag, see README)?
  ShutBusy == \E i \in Inst : shut[i] /\ instUp[i]
  Unjustified(h) == /\ ui \in LiveUi
                    /\ ~(~stopping /\ eSt = "RUNNING" /\ FreshH(h) /\ eCur = uiSess)

  TunAlive(t) == \/ androidOpen[t]
                 \/ \E b \in Br : bTun[b] = t /\ bSt[b] \in {"new", "up", "dead"}
  DefaultRoutes == osCur # 0 /\ tunKind[osCur] = "routed" /\ TunAlive(osCur)
end define;

macro Throw(kind)       \* establishAndStartEngine throws (the TUNs it owns are closed)
begin
  androidOpen := CloseOwned(androidOpen, self);
  jWown := [jWown EXCEPT ![self] = FALSE];
  jRown := [jRown EXCEPT ![self] = FALSE];
  jExc  := [jExc EXCEPT ![self] = kind];
end macro;

\* launchSerializedStart { ... }: the new job joins lastStartJob first.
\* (Serial mutant: start jobs join nothing, a reconnect joins only startJob.)
macro LaunchJob(k, i, rt, prv)
begin
  if nJob < MaxJobs then
    jobOn  := [jobOn  EXCEPT ![nJob + 1] = TRUE];
    jKind  := [jKind  EXCEPT ![nJob + 1] = k];
    jInst  := [jInst  EXCEPT ![nJob + 1] = i];
    jRetry := [jRetry EXCEPT ![nJob + 1] = rt];
    jEp    := [jEp    EXCEPT ![nJob + 1] = ep[i]];
    jPrev  := [jPrev  EXCEPT ![nJob + 1] = prv];
    startJob := [startJob EXCEPT ![i] = nJob + 1];
    lastJob := nJob + 1;
    nJob := nJob + 1;
  else
    boundHit := TRUE;
  end if;
end macro;

\* One poll iteration's decision, taken under stateLock (ifSessionCurrent /
\* onSessionFailed).  g = generation the iteration's loop was started for.
\* F6 mutant: no generation check (the old unsynchronised writes).
macro PollAct(sn, g)
begin
  if Mut("F6") \/ (sessLive /\ gen = g) then
    if Reason(sn) \in {"pump", "gw"}
       \/ (Timed /\ Reason(sn) = "stale" /\ pollStale + 1 >= StalePolls) then
      sessLive := FALSE;                             \* onSessionFailed: endSession(...)
      gen := gen + 1;
      pollOn := FALSE;
      if handler # 0 /\ vpnWanted then               \* first read of vpnWanted, in the lock
        ui := "RECONNECTING";
        uiSess := 0;
      end if;
      rcH := handler;                                \* handler read in the lock; called after it
      rcT := TRUE;
      pollStale := 0;
    elsif Reason(sn) = "stale" then
      pollStale := IF Timed THEN pollStale + 1 ELSE 0;  \* below the teardown threshold (untimed: never accrues)
    else
      pollStale := 0;
      ui := IF sn.disco = "stale" THEN "DEGRADED" ELSE "CONNECTED";
      uiSess := sn.sess;
    end if;
  end if;
end macro;

(**************************** Go engine entry points ***********************)

\* lifecycle.go: Prepare
procedure Prepare()
variables ps = 0, pprev = 0;
begin
P1: await ~stopping;                                   \* for globalCore.stopping { <-ch }
    if nSess < MaxSess then
      pprev := eCur;                                   \* prev := globalCore.sess
      ps := nSess + 1;
      sOwner := [sOwner EXCEPT ![nSess + 1] = self];
      staleStop := staleStop \/ (eCur # 0 /\ sOwner[eCur] > self);   \* closeSession(prev) kills a younger job's session
      eCur := nSess + 1;
      eSt := "PREPARING";
      prepAfterShut := prepAfterShut \/ (self \in Jobs /\ shut[jInst[self]] /\ ~instUp[jInst[self]]);
      nSess := nSess + 1;
    else
      boundHit := TRUE;
      ret := [ret EXCEPT ![self] = "err"];
      return;
    end if;
P2: if pprev # 0 then                                  \* closeSession(prev)
      sCanc := [sCanc EXCEPT ![pprev] = TRUE];
      bSt := StopBr(bSt, sBr[pprev]);
    end if;
P3: either                                             \* Ping / probes fail or are cancelled
      await sCanc[ps] \/ ~Reach \/ (EnPrepFail /\ faults < MaxFaults);
      if ~(sCanc[ps] \/ ~Reach) then faults := faults + 1; end if;
      if eCur = ps /\ eSt = "PREPARING" then           \* abandonPrepare
        eCur := 0;
        eSt := "STOPPED";
      end if;
      sCanc := [sCanc EXCEPT ![ps] = TRUE];
      ret := [ret EXCEPT ![self] = "err"];
      return;
    or                                                 \* handshake succeeded
      await Reach /\ ~sCanc[ps];
      skip;
    end either;
P5: if eCur # ps \/ sCanc[ps] then                     \* final publish under mu
      ret := [ret EXCEPT ![self] = "err"];             \* context.Canceled
      return;
    else
      sClient := [sClient EXCEPT ![ps] = TRUE];
      eSt := "PREPARED";
      ret := [ret EXCEPT ![self] = "ok"];
      return;
    end if;
end procedure;

\* lifecycle.go: AttachTun(tunFD)
procedure AttachTun(tun)
variables as = 0, ab = 0;
begin
A1: if eCur = 0 \/ ~(eSt \in {"PREPARED", "RUNNING"}) then
      ret := [ret EXCEPT ![self] = "err"];
      return;
    elsif ~sClient[eCur] then
      ret := [ret EXCEPT ![self] = "err"];
      return;
    else                                               \* first mu region + old-bridge stop
      as := eCur;
      bCb := CbOff(bCb, sBr[eCur]);
      bSt := StopBr(bSt, sBr[eCur]);
      sBr := [sBr EXCEPT ![eCur] = 0];
      eSt := "ATTACHING";
    end if;
A3: if sCanc[as] then                                  \* parentCtx.Err() != nil
      eSt := AbandonAttach;
      ret := [ret EXCEPT ![self] = "err"];
      return;
    end if;
A4: either                                             \* newTunBridge fails
      await EnAttachFail /\ faults < MaxFaults;
      faults := faults + 1;
      eSt := AbandonAttach;
      ret := [ret EXCEPT ![self] = "err"];
      return;
    or
      if nBr < MaxBr then
        ab := nBr + 1;
        bSt   := [bSt   EXCEPT ![nBr + 1] = "new"];
        bCb   := [bCb   EXCEPT ![nBr + 1] = TRUE];     \* setOnPumpDead before publish
        bSess := [bSess EXCEPT ![nBr + 1] = as];
        bTun  := [bTun  EXCEPT ![nBr + 1] = tun];
        nBr := nBr + 1;
      else
        boundHit := TRUE;
        eSt := AbandonAttach;
        ret := [ret EXCEPT ![self] = "err"];
        return;
      end if;
    end either;
A5: if GuardIdentity /\ (eCur # as \/ sCanc[as]) then  \* publish ownership under mu
      bSt := StopBr(bSt, ab);
      ret := [ret EXCEPT ![self] = "err"];
      return;
    else
      sBr := [sBr EXCEPT ![as] = ab];
      eSt := "ATTACHING";
    end if;
A6: if bSt[ab] = "new" then                            \* bridge.Start(): pumps launched
      bSt := [bSt EXCEPT ![ab] = "up"];
      disco := "ok";
    end if;
A7: if bSt[ab] = "up" /\ ~sCanc[as] then               \* Start() returned nil
      skip;
    else                                               \* Start() failed
      if eCur = as /\ sBr[as] = ab then
        sBr := [sBr EXCEPT ![as] = 0];
        eSt := AbandonAttach;
      end if;
      bSt := [bSt EXCEPT ![ab] = "stopped"];
      ret := [ret EXCEPT ![self] = "err"];
      return;
    end if;
A8: if GuardIdentity /\ (eCur # as \/ sCanc[as]) then  \* final mu region
      bSt := StopBr(bSt, ab);
      ret := [ret EXCEPT ![self] = "err"];
      return;
    elsif eSt = "FAILED" then
      ret := [ret EXCEPT ![self] = "err"];
      return;
    elsif GuardIdentity /\ sBr[as] # ab then
      bSt := StopBr(bSt, ab);
      ret := [ret EXCEPT ![self] = "err"];
      return;
    else
      eSt := "RUNNING";
      hAge := 0;
      sProven := [sProven EXCEPT ![as] = TRUE];
      ret := [ret EXCEPT ![self] = "ok"];
      return;
    end if;
end procedure;

\* lifecycle.go: Stop
procedure Stop()
variables ss = 0;
begin
S1: if eSt = "STOPPED" /\ ~stopping then
      ret := [ret EXCEPT ![self] = "ok"];
      return;
    elsif stopping then
      goto SWait;
    else
      stopping := TRUE;
      ss := eCur;
      eCur := 0;
      eSt := "STOPPING";
      hAge := -1;
    end if;
S2: if ss # 0 then                                     \* closeSession(sess)
      sCanc := [sCanc EXCEPT ![ss] = TRUE];
      bSt := StopBr(bSt, sBr[ss]);
    end if;
S3: eSt := "STOPPED";                                  \* the deferred func
    stopping := FALSE;
    ret := [ret EXCEPT ![self] = "ok"];
    return;
SWait: await ~stopping;                                \* <-ch
    ret := [ret EXCEPT ![self] = "ok"];
    return;
end procedure;

\* lifecycle.go: DetachTun is modelled inline in the job (single atomic step).

(***************** Kotlin: shutdown() ******************************************)

\* TailcatVpnService.shutdown().  Called inline by whoever invokes it: a start
\* job (abandonStaleStart / onVpnStartFailed), the launched coroutine of a STOP
\* intent or onRevoke (shM = "sync", an IO thread), or onDestroy on the main
\* thread (shM = "async").  The CAS + epoch bump happen under interfaceLock, so
\* establishAndAdopt and the CONNECTED publish are atomic with respect to it.
\* shEp = -1: unconditional shutdown(); otherwise shutdown(epoch), which does
\* nothing unless shutdownEpoch still equals shEp (checked in the CAS step).
\* shSG likewise scopes a STOP intent's shutdown to the starts accepted
\* before the intent (startGeneration).
procedure Shutdown(shI, shM, shEp, shSG)
begin
SHc:  if shut[shI] \/ (shEp # -1 /\ ep[shI] # shEp) \/ (shSG # -1 /\ sGen[shI] # shSG) then
        return;                                        \* scoped checks / compareAndSet(false, true) failed
      else
        shut := [shut EXCEPT ![shI] = TRUE];
        ep   := [ep EXCEPT ![shI] = ep[shI] + 1];
        casGen := [casGen EXCEPT ![shI] = sGen[shI]];
      end if;
SH1:  handler := 0;                                    \* sessionFailureHandler = null
      if startJob[shI] # 0 then                         \* startJob?.cancel() (the CURRENT startJob)
        jCanc := [jCanc EXCEPT ![startJob[shI]] = TRUE];
      end if;
      pollOn := FALSE;                                 \* stopPolling()
SH2:  androidOpen := CloseT(androidOpen, vpnIf[shI]);   \* tun?.close()
      vpnIf := [vpnIf EXCEPT ![shI] = 0];
SH3:  if shM = "sync" then
        call Stop();                                   \* IO thread: tunnelEngine.stop()
      else
        pendNS := shI;                                  \* main thread: pendingNativeStop = launch
        nsRun := [nsRun EXCEPT ![shI] = TRUE];
      end if;
SH4:  if shM = "sync" then
        finReq := [finReq EXCEPT ![shI] = TRUE];        \* Handler.post(finish)
      else                                             \* finish() inline on the main thread
        doneGen := [doneGen EXCEPT ![shI] = casGen[shI]];
        sessLive := FALSE;                             \* onVpnStopped: endSession(DISCONNECTED)
        gen := gen + 1;
        pollOn := FALSE;
        ui := "DISCONNECTED";
        uiSess := 0;
        instUp := [instUp EXCEPT ![shI] = FALSE];
      end if;
      return;
end procedure;

(************************ Go goroutines (per bridge / session) *************)

\* bridge.go: required pump exits (reportPumpDead) and the callback chain
\* installed by AttachTun: onPumpDead -> markFailed(sess, bridge, err) (lifecycle.go).
\* Fixed code: markFailed checks c.sess == sess && sess.bridge == bridge && state
\* in ONE lock region.  F1 mutant: the old closure checked `live` in one lock
\* region and markFailed (without the bridge check) ran in another.
fair process bpump \in BPs
variables bx = self - 300;
begin
BPL: while TRUE do
BPw: either                                            \* a required pump dies
       await EnPump /\ bx \in PumpBr /\ bSt[bx] = "up" /\ ~sCanc[bSess[bx]] /\ faults < MaxFaults;
       faults := faults + 1;
       bSt := [bSt EXCEPT ![bx] = "dead"];
       if bCb[bx] then
         if Mut("F1") then
           cbSt := [cbSt EXCEPT ![bx] = "chk"];         \* fn captured at report time; live check first
         elsif SplitCb then
           cbSt := [cbSt EXCEPT ![bx] = "mark"];        \* fn captured at report time
         elsif eCur = bSess[bx] /\ sBr[bSess[bx]] = bx /\ eSt \in {"RUNNING", "ATTACHING"} then
           eSt := "FAILED";                             \* report + markFailed fused
           hAge := -1;
           gcPend := [gcPend EXCEPT ![bSess[bx]] = TRUE];
         end if;
       end if;
     or                                                \* old only: live := cur==sess && sess.bridge==bridge
       await cbSt[bx] = "chk";
       if eCur = bSess[bx] /\ sBr[bSess[bx]] = bx then
         cbSt := [cbSt EXCEPT ![bx] = "mark"];
       else
         cbSt := [cbSt EXCEPT ![bx] = "none"];
       end if;
     or                                                \* markFailed(sess, bridge, err)
       await cbSt[bx] = "mark";
       if (eCur = bSess[bx] \/ ~GuardMarkFailed) /\ eSt \in {"RUNNING", "ATTACHING"}
          /\ (Mut("F1") \/ sBr[bSess[bx]] = bx) then
         eSt := "FAILED";
         hAge := -1;
         gcPend := [gcPend EXCEPT ![bSess[bx]] = TRUE];
       end if;
       cbSt := [cbSt EXCEPT ![bx] = "none"];
     end either;
end while;
end process;

\* markFailed: `go closeSession(sess)`
fair process gc \in GCs
begin
GCL: while TRUE do
GCw:  await gcPend[self - 400];
GCc:  sCanc := [sCanc EXCEPT ![self - 400] = TRUE];
      bSt := StopBr(bSt, sBr[self - 400]);
      gcPend := [gcPend EXCEPT ![self - 400] = FALSE];
end while;
end process;

\* serviceScope.launch { shutdown() } for a STOP intent / onRevoke
fair process sd \in SDs
begin
SDL: while TRUE do
SDw:  await sdReq[self - 100];
      sdReq := [sdReq EXCEPT ![self - 100] = FALSE];
      call Shutdown(self - 100, "sync", -1, sdGen[self - 100]);
SDe:  skip;
end while;
end process;

\* the posted finish(): onVpnStopped; stopForeground; stopSelf -> (later) onDestroy.
\* It runs on the main looper, so never in the middle of another main-thread message.
fair process fin \in FINs
begin
FNL: while TRUE do
FNw:  await finReq[self - 500] /\ pc[3000] \in {"ML", "MG"};
      finReq := [finReq EXCEPT ![self - 500] = FALSE];
      if ~Mut("N1b") /\ sGen[self - 500] # casGen[self - 500] then
        skip;                                          \* a START accepted after the CAS owns the instance now
      else
        doneGen := [doneGen EXCEPT ![self - 500] = casGen[self - 500]];
        sessLive := FALSE;                             \* onVpnStopped: endSession(DISCONNECTED)
        gen := gen + 1;
        pollOn := FALSE;
        ui := "DISCONNECTED";
        uiSess := 0;
        if Mut("N1b") \/ ~PendingStart then            \* stopSelf(lastStartId); old: stopSelf()
          instUp := [instUp EXCEPT ![self - 500] = FALSE];
          dReq   := [dReq   EXCEPT ![self - 500] = EnOnDestroy];   \* ... the system then calls onDestroy()
        end if;
      end if;
end while;
end process;

fair process ns \in NSs
begin
NSL: while TRUE do
NSw:  await nsRun[self - 200];
NSc:  call Stop();
NSd:  nsRun := [nsRun EXCEPT ![self - 200] = FALSE];
end while;
end process;

(***************** Kotlin: start / reconnect coroutine *********************)

\* TailcatVpnService.launchSerializedStart + startWithRetry + establishAndStartEngine
\* (and the reconnectAfterFailure launch body for kind = "reconn")
fair process job \in Jobs
variables perm = FALSE;
begin
JStart:
  await jobOn[self];
JJoin:                                                 \* previous?.join()   (lastStartJob)
  await jPrev[self] = 0 \/ jCanc[self] \/ PrevDone(self);
  if jPrev[self] # 0 /\ jCanc[self] then goto JEnd; end if;
JKind:
  if jKind[self] = "reconn" then
RChk:                                                  \* if (isStale(epoch)) return
    if ~Mut("F4") /\ Stale(self) then goto JEnd; end if;
RReset:                                                \* resetForRetry()
    staleStop := staleStop \/ (eCur # 0 /\ sOwner[eCur] > self);
    androidOpen := CloseT(androidOpen, vpnIf[jInst[self]]);
    vpnIf := [vpnIf EXCEPT ![jInst[self]] = 0];
    call Stop();
RNote:                                                 \* validateStartRequest + notification
    skip;
  end if;
JoinNS:                                                \* pendingNativeStop?.join()
  await ~GuardJoinNS \/ NsDone;
  if GuardJoinNS /\ pendNS # 0 /\ jCanc[self] then goto JEnd; end if;
Loop:                                                  \* establishAndStartEngine: ensureActive(); checkNotShuttingDown(epoch)
  if ~Mut("F2") /\ Cancelled(self) then                 \* last check before a native session exists
    Throw("cancel"); goto Catch;
  end if;
PrepCall:
  call Prepare();
PrepRet:
  if ret[self] = "err" then
    Throw("err"); goto Catch;
  elsif Cancelled(self) then                           \* ensureActive(); checkNotShuttingDown(epoch)
    Throw("cancel"); goto Catch;
  end if;
WarmEst:
  if Mut("F3a") then                                   \* old: establish(), then adoptInterface() separately
    if nTun < MaxTun then
      tunKind := [tunKind EXCEPT ![nTun + 1] = "warm"];
      androidOpen := [androidOpen EXCEPT ![nTun + 1] = TRUE];
      osCur := nTun + 1;
      jW := [jW EXCEPT ![self] = nTun + 1];
      jWown := [jWown EXCEPT ![self] = TRUE];
      nTun := nTun + 1;
    else
      boundHit := TRUE; Throw("err"); goto Catch;
    end if;
  elsif Stale(self) then                               \* establishAndAdopt: checkNotShuttingDown inside interfaceLock
    Throw("cancel"); goto Catch;
  elsif nTun < MaxTun then                             \* ... establish() + vpnInterface = it, same lock region
    tunKind := [tunKind EXCEPT ![nTun + 1] = "warm"];
    androidOpen := [androidOpen EXCEPT ![nTun + 1] = TRUE];
    osCur := nTun + 1;
    jW := [jW EXCEPT ![self] = nTun + 1];
    vpnIf := [vpnIf EXCEPT ![jInst[self]] = nTun + 1];
    nTun := nTun + 1;
  else
    boundHit := TRUE; Throw("err"); goto Catch;
  end if;
WarmAdopt:                                             \* old only: adoptInterface(warm)
  if Mut("F3a") then
    if shut[jInst[self]] then
      Throw("cancel"); goto Catch;
    else
      vpnIf := [vpnIf EXCEPT ![jInst[self]] = jW[self]];
      jWown := [jWown EXCEPT ![self] = FALSE];
    end if;
  end if;
WarmAttach:                                            \* attachLive(warm): checks, then attachTun
  if Cancelled(self) then
    Throw("cancel"); goto Catch;
  else
    call AttachTun(jW[self]);
  end if;
WarmAttachRet:
  if ret[self] = "err" then Throw("err"); goto Catch; end if;
WarmSnap:                                              \* getStats(); check(shouldConnect)
  if ~LiveSnap(Snap) then Throw("err"); goto Catch; end if;
Sweep1:                                                \* protect sweep; ensureActive; checkNotShuttingDown
  if Cancelled(self) then Throw("cancel"); goto Catch; end if;
Disarm:                                                \* tunnelEngine.disarmPumps()
  if eCur # 0 /\ sBr[eCur] # 0 then
    bCb := CbOff(bCb, sBr[eCur]);
  end if;
Detach:                                                \* tunnelEngine.detachTun()
  if eCur = 0 then
    if ~Mut("F3b") then                                \* fixed: "cannot detach TUN: engine not prepared"
      Throw("err"); goto Catch;
    end if;
  elsif ~(eSt \in {"RUNNING", "ATTACHING", "PREPARED"}) then
    Throw("err"); goto Catch;
  else
    bCb := CbOff(bCb, sBr[eCur]);
    bSt := StopBr(bSt, sBr[eCur]);
    sBr := [sBr EXCEPT ![eCur] = 0];
    eSt := "PREPARED";
    hAge := -1;
  end if;
RoutedEst:
  if Mut("F3a") then
    if nTun < MaxTun then
      tunKind := [tunKind EXCEPT ![nTun + 1] = "routed"];
      androidOpen := [androidOpen EXCEPT ![nTun + 1] = TRUE];
      osCur := nTun + 1;
      jR := [jR EXCEPT ![self] = nTun + 1];
      jRown := [jRown EXCEPT ![self] = TRUE];
      nTun := nTun + 1;
    else
      boundHit := TRUE; Throw("err"); goto Catch;
    end if;
  elsif Stale(self) then                               \* establishAndAdopt(routed)
    Throw("cancel"); goto Catch;
  elsif nTun < MaxTun then
    tunKind := [tunKind EXCEPT ![nTun + 1] = "routed"];
    androidOpen := [androidOpen EXCEPT ![nTun + 1] = TRUE];
    osCur := nTun + 1;
    jR := [jR EXCEPT ![self] = nTun + 1];
    vpnIf := [vpnIf EXCEPT ![jInst[self]] = nTun + 1];
    nTun := nTun + 1;
  else
    boundHit := TRUE; Throw("err"); goto Catch;
  end if;
RoutedClear:                                           \* warm.close()  (old: clearInterfaceIf(warm) first)
  if vpnIf[jInst[self]] = jW[self] then
    vpnIf := [vpnIf EXCEPT ![jInst[self]] = 0];
  end if;
  androidOpen := CloseT(androidOpen, jW[self]);
RoutedAdopt:                                           \* old only: adoptInterface(routed)
  if Mut("F3a") then
    if shut[jInst[self]] then
      Throw("cancel"); goto Catch;
    else
      vpnIf := [vpnIf EXCEPT ![jInst[self]] = jR[self]];
      jRown := [jRown EXCEPT ![self] = FALSE];
    end if;
  end if;
RoutedAttach:                                          \* attachLive(routed)
  if Cancelled(self) then
    Throw("cancel"); goto Catch;
  else
    call AttachTun(jR[self]);
  end if;
RoutedAttachRet:
  if ret[self] = "err" then Throw("err"); goto Catch; end if;
RoutedSnap:
  if ~LiveSnap(Snap) then
    Throw("err"); goto Catch;
  else
    jSnapSess := [jSnapSess EXCEPT ![self] = eCur];
  end if;
PostSweep:                                             \* ensureTransportProtect + protect sweep
  skip;
SetHandler:                                            \* synchronized(interfaceLock) { checkNotShuttingDown(epoch);
  if ~Mut("F5") /\ Stale(self) then                    \*   sessionFailureHandler = ...; onEngineConnected(metrics) }
    Throw("cancel"); goto Catch;
  else
    handler := jInst[self];
    ui := "CONNECTED";
    uiSess := jSnapSess[self];
    sessLive := TRUE;
    gen := gen + 1;
    pollGen := gen;                                    \* the loop started here polls the NEW generation (PlusCal: sequential, so gen is already gen+1)
    pollOn := EnPoll;                                  \* pollingJob = scope.launch {...}
    pollDue := EnPoll;
    pollStale := 0;
    goto JEnd;
  end if;
Catch:                                                 \* } catch in startWithRetry
  if jExc[self] = "cancel" then                        \* catch (CancellationException)
    goto Abandon;
  elsif ~Mut("F4") /\ Cancelled(self) then             \* catch (Exception): !isActive || isStale(epoch)
    goto Abandon;
  end if;
CatchPerm:                                             \* PermanentStartFailure / error text / consent
  either perm := TRUE; or perm := FALSE; end either;
CatchDecide:
  if ~Mut("N2") /\ ~Mut("F4") /\ Cancelled(self) then \* failStart: re-check staleness under interfaceLock, atomically with the effects
    goto Abandon;
  elsif ~jRetry[self] \/ perm \/ ~vpnWanted then
    vpnWanted := FALSE;                                \* onVpnStartFailed(serviceStopping = true): vpnWanted = false; endSession(current state)
    sessLive := FALSE;
    gen := gen + 1;
    pollOn := FALSE;
    ui := IF Mut("N1") THEN "DISCONNECTED" ELSE ui;    \* the state stays until finish()'s onVpnStopped says DISCONNECTED
    uiSess := 0;
    goto CatchShut;                                    \* ... then shutdown()
  end if;
RetryReset:                                            \* resetForRetry()
  perm := FALSE;
  staleStop := staleStop \/ (eCur # 0 /\ sOwner[eCur] > self);
  androidOpen := CloseT(androidOpen, vpnIf[jInst[self]]);
  vpnIf := [vpnIf EXCEPT ![jInst[self]] = 0];
  call Stop();
RetryNotify:                                           \* onStartRetrying(...): endSession(RECONNECTING)
  sessLive := FALSE;
  gen := gen + 1;
  pollOn := FALSE;
  ui := "RECONNECTING";
  uiSess := 0;
RetryDelay:                                            \* delay(waitMs)
  if jCanc[self] then goto JEnd; end if;
RetryDelay2:
  either await ~jCanc[self]; goto Loop;
  or await jCanc[self]; goto JEnd;
  end either;
Abandon:                                               \* abandonStaleStart(epoch): tunnelEngine.stop() ...
  staleStop := staleStop \/ (~Mut("F2") /\ eCur # 0 /\ sOwner[eCur] > self);
  if Mut("F2") then
    skip;
  else
    call Stop();
  end if;
AbShut:                                                \* ... shutdown(epoch)
  if Mut("F2") \/ Mut("Epoch") then
    call Shutdown(jInst[self], "sync", -1, -1);            \* old: unconditional shutdown()
  elsif Mut("N2") then
    if ep[jInst[self]] = jEp[self] then                \* old: check, then an unscoped shutdown() in a later step
      call Shutdown(jInst[self], "sync", -1, -1);
    end if;
  else
    call Shutdown(jInst[self], "sync", jEp[self], -1);
  end if;
AbEnd:
  goto JEnd;
CatchShut:                                             \* failStart: shutdown(epoch)
  call Shutdown(jInst[self], "sync", IF Mut("N2") THEN -1 ELSE jEp[self], -1);
CatchEnd:
  goto JEnd;
JEnd:
  jDone := [jDone EXCEPT ![self] = TRUE];
end process;

(*********************** Kotlin: TunnelController *************************)

\* TunnelController.onEngineConnected's polling loop
\* UiRaces = TRUE : one iteration is PR (read stats) ... PA (act on that snapshot);
\*                  ticks, cancellation and other threads may interleave between.
\* UiRaces = FALSE: the iteration is atomic (PR acts on the stats it just read; the
\*                  clock is blocked while PR..PA is pending).
\* PRc/PRe: the part of onSessionFailed AFTER the stateLock region:
\*   if (handler != null && preferences.vpnWanted) handler(cause) else stopTunnel()
\* where handler = reconnectAfterFailure(): if (shuttingDown) return; epoch = shutdownEpoch; launch.
fair process poll = 1000
variables psnap = [st |-> "STOPPED", fresh |-> FALSE, disco |-> "ok", sess |-> 0],
          pg = 0;
begin
PL: while TRUE do
PR:   await pollOn /\ (pollDue \/ ~Timed);
      pollDue := FALSE;
      pg := pollGen;
      if UiRaces then
        psnap := Snap;                                 \* getStats() ...
      else
        PollAct(Snap, pollGen);                        \* ... acted on atomically
      end if;
PA:   if UiRaces then                                  \* ... acted on after interleaving
        PollAct(psnap, pg);
        psnap := NoSnap;
      end if;
PRc:  if rcT then
        rcT := FALSE;
        if rcH # 0 /\ vpnWanted then                   \* second read of vpnWanted; handler(cause)
          rcE := ~shut[rcH];                           \* reconnectAfterFailure: if (shuttingDown.get()) return
        else                                           \* stopTunnel()
          vpnWanted := FALSE;
          intents := Append(intents, "STOP");
          rcE := FALSE;
          rcH := 0;
        end if;
      end if;
PRe:  if rcE then                                      \* epoch = shutdownEpoch.get(); startJob = launchSerializedStart {...}
        rcE := FALSE;
        LaunchJob("reconn", rcH, TRUE, IF Mut("Serial") THEN startJob[rcH] ELSE lastJob);
      end if;
      rcH := 0;
end while;
end process;

\* NetworkMonitor listener: restore CONNECTED after the network returns
fair process ncb = 1100
variables nsnap = [st |-> "STOPPED", fresh |-> FALSE, disco |-> "ok", sess |-> 0],
          nok = FALSE, ng = 0;
begin
NL: while TRUE do
NR1:  await netRestore;
      netRestore := FALSE;
      ng := netGen;
      if UiRaces then nsnap := Snap; end if;           \* tunnelEngine.getStats()
NR2:  if UiRaces then
        if Mut("F6") then                              \* old: check ... (then act in NR3)
          nok := sessLive /\ LiveSnap(nsnap);
        elsif sessLive /\ gen = ng /\ ui = "RECONNECTING" /\ LiveSnap(nsnap) then
          ui := "CONNECTED";                           \* ifSessionCurrent(generation) { ... }
          uiSess := nsnap.sess;
        end if;
NR3:    if nok then
          ui := "CONNECTED";
          uiSess := nsnap.sess;
        end if;
        nok := FALSE; nsnap := NoSnap;
      else
        if sessLive /\ LiveSnap(Snap) /\ (Mut("F6") \/ (gen = ng /\ ui = "RECONNECTING")) then
          ui := "CONNECTED";
          uiSess := eCur;
        end if;
      end if;
end while;
end process;

(****************** Kotlin main thread: onStartCommand *********************)

fair process main = 3000
variables it = "", mi = 0, mgo = FALSE;
begin
ML: while TRUE do
MG:  either
       await intents # <<>>;
       it := Head(intents);
       intents := Tail(intents);
       mi := 0;
     or                                                \* onDestroy() after stopSelf()
       await \E x \in Inst : dReq[x];
       mi := CHOOSE x \in Inst : dReq[x];
       dReq := [dReq EXCEPT ![mi] = FALSE];
       it := "DESTROYED";
     end either;
MR:  if mi # 0 then                                    \* DESTROYED already names its instance
       skip;
     elsif \E x \in Inst : instUp[x] then              \* the live service instance
       mi := CHOOSE x \in Inst : instUp[x];
     elsif it \in {"REVOKE", "DESTROY"} then            \* nothing to call back into
       mi := 0;
     elsif nInst < MaxInst then                        \* system creates the service
       mi := nInst + 1;
       instUp := [instUp EXCEPT ![nInst + 1] = TRUE];
       shut   := [shut   EXCEPT ![nInst + 1] = FALSE];
       nInst := nInst + 1;
     else
       boundHit := TRUE;
       mi := 0;
     end if;
MS:  if mi = 0 then
       skip;
     elsif it = "REVOKE" then                          \* onRevoke(): vpnWanted=false; launch { shutdown() }
       vpnWanted := FALSE;
       sdReq := [sdReq EXCEPT ![mi] = TRUE];
       sdGen := [sdGen EXCEPT ![mi] = -1];
     elsif it \in {"DESTROY", "DESTROYED"} then        \* onDestroy(): shutdown() on the main thread
       instUp := [instUp EXCEPT ![mi] = FALSE];
       if ~shut[mi] then
         call Shutdown(mi, "async", -1, -1);
       end if;
     elsif it = "STOP" then                            \* ACTION_STOP_VPN
       if Mut("F7") then vpnWanted := FALSE; end if;   \* old: the intent cleared vpnWanted again
       if Mut("N1b") then                              \* old: always launch { shutdown() }, unscoped
         sdReq := [sdReq EXCEPT ![mi] = TRUE];
         sdGen := [sdGen EXCEPT ![mi] = -1];
       elsif sGen[mi] = doneGen[mi] then               \* nothing started here since the last finish(): stopSelf(startId)
         if ~PendingStart then
           instUp := [instUp EXCEPT ![mi] = FALSE];
           dReq   := [dReq   EXCEPT ![mi] = EnOnDestroy];
         end if;
       elsif shut[mi] \/ vpnWanted then                \* a shutdown is in flight / a Connect followed the Disconnect
         skip;
       else                                            \* launch { shutdown(startGeneration = gen) }
         sdReq := [sdReq EXCEPT ![mi] = TRUE];
         sdGen := [sdGen EXCEPT ![mi] = IF sdReq[mi] /\ sdGen[mi] = -1 THEN -1 ELSE sGen[mi]];
       end if;
     elsif (Mut("Dup") \/ ~shut[mi]) /\ (JobActive(startJob[mi]) \/ vpnIf[mi] # 0) then
       skip;                                           \* duplicate start: return START_STICKY
     else
       if it = "AO" then vpnWanted := TRUE; end if;    \* SERVICE_INTERFACE
       shut := [shut EXCEPT ![mi] = FALSE];            \* synchronized(interfaceLock) { startGeneration++; shuttingDown.set(false) }
       sGen := [sGen EXCEPT ![mi] = sGen[mi] + 1];
       ui := "CONNECTING";
       uiSess := 0;
       mgo := TRUE;
     end if;
MS2: if mgo then                                       \* synchronized(startLock) { epoch = shutdownEpoch.get(); startJob = launchSerializedStart {...} }
       mgo := FALSE;
       LaunchJob("start", mi, (it # "USER"), IF Mut("Serial") THEN 0 ELSE lastJob);
     end if;
MEnd: it := ""; mi := 0;
end while;
end process;

(*************************** Environment ***********************************)

\* Clock: one tick = one poll period (1 s).  A poll runs once per tick.
fair process clk = 2000
begin
TL: while TRUE do
Tk:   await Timed /\ ~(pollDue /\ pollOn) /\ (UiRaces \/ pc[1000] # "PA");
      hAge := NextH;
      disco := NextDisco;
      pollDue := pollOn;
      badTicks := IF Unjustified(NextH) /\ ~ShutBusy
                  THEN Min(badTicks + 1, BadBound + 1) ELSE 0;
end while;
end process;

\* Network / gateway loss, OS destroying the service (not fair: may never occur)
process env = 4000
begin
EL: while TRUE do
EE:   either                                           \* NetworkCallback.onLost
        await EnNet /\ net = "up" /\ faults < MaxFaults;
        faults := faults + 1;
        net := "down";
        if ui = "CONNECTED" then ui := "RECONNECTING"; end if;
      or                                               \* network available again
        await net = "down";
        net := "up";
        if ui = "RECONNECTING" /\ sessLive then
          netRestore := TRUE;
          netGen := gen;                               \* generation read under stateLock
        end if;
      or                                               \* gateway stops answering
        await EnGw /\ gw = "up" /\ faults < MaxFaults;
        faults := faults + 1;
        gw := "down";
      or
        await gw = "down";
        gw := "up";
      or                                               \* OS destroys the service: onDestroy()
        await EnDestroy /\ (\E x \in Inst : instUp[x]) /\ faults < MaxFaults;
        faults := faults + 1;
        intents := Append(intents, "DESTROY");
      end either;
end while;
end process;

\* UI thread / system: Connect, restore, Disconnect, onRevoke
process user = 5000
begin
UL: while TRUE do
UE:   either                                           \* Connect tap: startTunnel(userInitiated=true)
        await ui = "DISCONNECTED" /\ starts < MaxStarts;
        starts := starts + 1;
        vpnWanted := TRUE;
        ui := "CONNECTING";
        uiSess := 0;
        intents := Append(intents, "USER");
      or                                               \* restoreIfWanted(): startTunnel(false)
        await EnRestore /\ ui = "DISCONNECTED" /\ starts < MaxStarts /\ vpnWanted;
        starts := starts + 1;
        ui := "CONNECTING";
        uiSess := 0;
        intents := Append(intents, "AUTO");
      or                                               \* system Always-on start (SERVICE_INTERFACE)
        await EnAlwaysOn /\ ui = "DISCONNECTED" /\ starts < MaxStarts;
        starts := starts + 1;
        intents := Append(intents, "AO");
      or                                               \* Disconnect tap: stopTunnel()
        await EnDisc /\ ui # "DISCONNECTED" /\ discs < MaxDisc;
        discs := discs + 1;
        vpnWanted := FALSE;
        pollOn := FALSE;                               \* stopPolling()
        intents := Append(intents, "STOP");
      or                                               \* onRevoke()
        await EnRevoke /\ (\E x \in Inst : instUp[x]) /\ discs < MaxDisc;
        discs := discs + 1;
        intents := Append(intents, "REVOKE");
      end either;
end while;
end process;

end algorithm; *)

\* BEGIN TRANSLATION
CONSTANT defaultInitValue
VARIABLES eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, sBr, 
          sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, ret, 
          nTun, tunKind, androidOpen, osCur, nInst, instUp, shut, ep, vpnIf, 
          startJob, sdReq, sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
          pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
          jRetry, jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, ui, uiSess, 
          sessLive, gen, handler, vpnWanted, pollOn, pollDue, pollStale, 
          pollGen, rcH, rcT, rcE, netRestore, netGen, intents, net, gw, 
          faults, starts, discs, badTicks, prepAfterShut, staleStop, boundHit, 
          pc, stack

(* define statement *)
Mut(m) == m \in Mutants


PendingStart == \E k \in 1..Len(intents) : intents[k] \in {"USER", "AUTO", "AO", "STOP"}

Reach == net = "up" /\ gw = "up"
FreshH(h) == h >= 0 /\ h <= FreshMax
LiveUi == {"CONNECTED", "DEGRADED"}


Snap == [st    |-> IF stopping THEN "STOPPING" ELSE eSt,
         fresh |-> FreshH(hAge),
         disco |-> disco,
         sess  |-> eCur]
NoSnap == [st |-> "STOPPED", fresh |-> FALSE, disco |-> "ok", sess |-> 0]
LiveSnap(s) == s.st = "RUNNING" /\ s.fresh
Reason(s) == IF s.st = "FAILED" THEN "pump"
             ELSE IF ~LiveSnap(s) THEN "stale"
             ELSE IF s.disco = "lost" THEN "gw"
             ELSE "ok"

StopBr(f, b) == IF b = 0 THEN f ELSE [f EXCEPT ![b] = "stopped"]
CbOff(f, b)  == IF b = 0 THEN f ELSE [f EXCEPT ![b] = FALSE]
CloseT(f, t) == IF t = 0 THEN f ELSE [f EXCEPT ![t] = FALSE]
CloseOwned(f, j) == [t \in Tun |-> IF (jWown[j] /\ t = jW[j])
                                      \/ (jRown[j] /\ t = jR[j])
                                   THEN FALSE ELSE f[t]]
NsDone == IF pendNS = 0 THEN TRUE ELSE ~nsRun[pendNS]
PrevDone(j) == IF jPrev[j] = 0 THEN TRUE ELSE jDone[jPrev[j]]
JobActive(j) == IF j = 0 THEN FALSE
                ELSE jobOn[j] /\ ~jDone[j] /\ ~jCanc[j]
AbandonAttach == IF eCur # 0 /\ eSt \in {"ATTACHING", "PREPARED"}
                 THEN "PREPARED" ELSE eSt


Stale(j) == shut[jInst[j]] \/ (~Mut("Epoch") /\ ep[jInst[j]] # jEp[j])

Cancelled(j) == jCanc[j] \/ Stale(j)

HeartbeatAlive == /\ eCur # 0
                  /\ sBr[eCur] # 0
                  /\ bSt[sBr[eCur]] = "up"
NextH == IF HeartbeatAlive THEN 0
         ELSE IF hAge < 0 THEN -1 ELSE Min(hAge + 1, HCap)
NextDisco == IF Reach THEN "ok"
             ELSE IF disco = "ok" THEN "stale" ELSE "lost"


ShutBusy == \E i \in Inst : shut[i] /\ instUp[i]
Unjustified(h) == /\ ui \in LiveUi
                  /\ ~(~stopping /\ eSt = "RUNNING" /\ FreshH(h) /\ eCur = uiSess)

TunAlive(t) == \/ androidOpen[t]
               \/ \E b \in Br : bTun[b] = t /\ bSt[b] \in {"new", "up", "dead"}
DefaultRoutes == osCur # 0 /\ tunKind[osCur] = "routed" /\ TunAlive(osCur)

VARIABLES ps, pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
          pg, nsnap, nok, ng, it, mi, mgo

vars == << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, sBr, 
           sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, ret, 
           nTun, tunKind, androidOpen, osCur, nInst, instUp, shut, ep, vpnIf, 
           startJob, sdReq, sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
           pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
           jRetry, jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, ui, uiSess, 
           sessLive, gen, handler, vpnWanted, pollOn, pollDue, pollStale, 
           pollGen, rcH, rcT, rcE, netRestore, netGen, intents, net, gw, 
           faults, starts, discs, badTicks, prepAfterShut, staleStop, 
           boundHit, pc, stack, ps, pprev, tun, as, ab, ss, shI, shM, shEp, 
           shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

ProcSet == (BPs) \cup (GCs) \cup (SDs) \cup (FINs) \cup (NSs) \cup (Jobs) \cup {1000} \cup {1100} \cup {3000} \cup {2000} \cup {4000} \cup {5000}

Init == (* Global variables *)
        /\ eSt = "STOPPED"
        /\ eCur = 0
        /\ stopping = FALSE
        /\ hAge = -1
        /\ disco = "ok"
        /\ nSess = 0
        /\ sCanc = [s \in Sess |-> FALSE]
        /\ sClient = [s \in Sess |-> FALSE]
        /\ sBr = [s \in Sess |-> 0]
        /\ sProven = [s \in Sess |-> FALSE]
        /\ sOwner = [s \in Sess |-> 0]
        /\ gcPend = [s \in Sess |-> FALSE]
        /\ nBr = 0
        /\ bSt = [b \in Br |-> "free"]
        /\ bCb = [b \in Br |-> FALSE]
        /\ bSess = [b \in Br |-> 0]
        /\ bTun = [b \in Br |-> 0]
        /\ cbSt = [b \in Br |-> "none"]
        /\ ret = [c \in Callers |-> "none"]
        /\ nTun = 0
        /\ tunKind = [t \in Tun |-> "none"]
        /\ androidOpen = [t \in Tun |-> FALSE]
        /\ osCur = 0
        /\ nInst = 0
        /\ instUp = [i \in Inst |-> FALSE]
        /\ shut = [i \in Inst |-> FALSE]
        /\ ep = [i \in Inst |-> 0]
        /\ vpnIf = [i \in Inst |-> 0]
        /\ startJob = [i \in Inst |-> 0]
        /\ sdReq = [i \in Inst |-> FALSE]
        /\ sdGen = [i \in Inst |-> -1]
        /\ sGen = [i \in Inst |-> 0]
        /\ casGen = [i \in Inst |-> 0]
        /\ doneGen = [i \in Inst |-> 0]
        /\ finReq = [i \in Inst |-> FALSE]
        /\ dReq = [i \in Inst |-> FALSE]
        /\ nsRun = [i \in Inst |-> FALSE]
        /\ pendNS = 0
        /\ lastJob = 0
        /\ nJob = 0
        /\ jobOn = [j \in Jobs |-> FALSE]
        /\ jDone = [j \in Jobs |-> FALSE]
        /\ jCanc = [j \in Jobs |-> FALSE]
        /\ jKind = [j \in Jobs |-> "start"]
        /\ jInst = [j \in Jobs |-> 1]
        /\ jEp = [j \in Jobs |-> 0]
        /\ jRetry = [j \in Jobs |-> FALSE]
        /\ jPrev = [j \in Jobs |-> 0]
        /\ jExc = [j \in Jobs |-> "none"]
        /\ jW = [j \in Jobs |-> 0]
        /\ jWown = [j \in Jobs |-> FALSE]
        /\ jR = [j \in Jobs |-> 0]
        /\ jRown = [j \in Jobs |-> FALSE]
        /\ jSnapSess = [j \in Jobs |-> 0]
        /\ ui = "DISCONNECTED"
        /\ uiSess = 0
        /\ sessLive = FALSE
        /\ gen = 0
        /\ handler = 0
        /\ vpnWanted = FALSE
        /\ pollOn = FALSE
        /\ pollDue = FALSE
        /\ pollStale = 0
        /\ pollGen = 0
        /\ rcH = 0
        /\ rcT = FALSE
        /\ rcE = FALSE
        /\ netRestore = FALSE
        /\ netGen = 0
        /\ intents = <<>>
        /\ net = "up"
        /\ gw = "up"
        /\ faults = 0
        /\ starts = 0
        /\ discs = 0
        /\ badTicks = 0
        /\ prepAfterShut = FALSE
        /\ staleStop = FALSE
        /\ boundHit = FALSE
        (* Procedure Prepare *)
        /\ ps = [ self \in ProcSet |-> 0]
        /\ pprev = [ self \in ProcSet |-> 0]
        (* Procedure AttachTun *)
        /\ tun = [ self \in ProcSet |-> defaultInitValue]
        /\ as = [ self \in ProcSet |-> 0]
        /\ ab = [ self \in ProcSet |-> 0]
        (* Procedure Stop *)
        /\ ss = [ self \in ProcSet |-> 0]
        (* Procedure Shutdown *)
        /\ shI = [ self \in ProcSet |-> defaultInitValue]
        /\ shM = [ self \in ProcSet |-> defaultInitValue]
        /\ shEp = [ self \in ProcSet |-> defaultInitValue]
        /\ shSG = [ self \in ProcSet |-> defaultInitValue]
        (* Process bpump *)
        /\ bx = [self \in BPs |-> self - 300]
        (* Process job *)
        /\ perm = [self \in Jobs |-> FALSE]
        (* Process poll *)
        /\ psnap = [st |-> "STOPPED", fresh |-> FALSE, disco |-> "ok", sess |-> 0]
        /\ pg = 0
        (* Process ncb *)
        /\ nsnap = [st |-> "STOPPED", fresh |-> FALSE, disco |-> "ok", sess |-> 0]
        /\ nok = FALSE
        /\ ng = 0
        (* Process main *)
        /\ it = ""
        /\ mi = 0
        /\ mgo = FALSE
        /\ stack = [self \in ProcSet |-> << >>]
        /\ pc = [self \in ProcSet |-> CASE self \in BPs -> "BPL"
                                        [] self \in GCs -> "GCL"
                                        [] self \in SDs -> "SDL"
                                        [] self \in FINs -> "FNL"
                                        [] self \in NSs -> "NSL"
                                        [] self \in Jobs -> "JStart"
                                        [] self = 1000 -> "PL"
                                        [] self = 1100 -> "NL"
                                        [] self = 3000 -> "ML"
                                        [] self = 2000 -> "TL"
                                        [] self = 4000 -> "EL"
                                        [] self = 5000 -> "UL"]

P1(self) == /\ pc[self] = "P1"
            /\ ~stopping
            /\ IF nSess < MaxSess
                  THEN /\ pprev' = [pprev EXCEPT ![self] = eCur]
                       /\ ps' = [ps EXCEPT ![self] = nSess + 1]
                       /\ sOwner' = [sOwner EXCEPT ![nSess + 1] = self]
                       /\ staleStop' = (staleStop \/ (eCur # 0 /\ sOwner'[eCur] > self))
                       /\ eCur' = nSess + 1
                       /\ eSt' = "PREPARING"
                       /\ prepAfterShut' = (prepAfterShut \/ (self \in Jobs /\ shut[jInst[self]] /\ ~instUp[jInst[self]]))
                       /\ nSess' = nSess + 1
                       /\ pc' = [pc EXCEPT ![self] = "P2"]
                       /\ UNCHANGED << ret, boundHit, stack >>
                  ELSE /\ boundHit' = TRUE
                       /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ ps' = [ps EXCEPT ![self] = Head(stack[self]).ps]
                       /\ pprev' = [pprev EXCEPT ![self] = Head(stack[self]).pprev]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                       /\ UNCHANGED << eSt, eCur, nSess, sOwner, prepAfterShut, 
                                       staleStop >>
            /\ UNCHANGED << stopping, hAge, disco, sCanc, sClient, sBr, 
                            sProven, gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                            nTun, tunKind, androidOpen, osCur, nInst, instUp, 
                            shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                            casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                            lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, 
                            jEp, jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                            jSnapSess, ui, uiSess, sessLive, gen, handler, 
                            vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                            rcH, rcT, rcE, netRestore, netGen, intents, net, 
                            gw, faults, starts, discs, badTicks, tun, as, ab, 
                            ss, shI, shM, shEp, shSG, bx, perm, psnap, pg, 
                            nsnap, nok, ng, it, mi, mgo >>

P2(self) == /\ pc[self] = "P2"
            /\ IF pprev[self] # 0
                  THEN /\ sCanc' = [sCanc EXCEPT ![pprev[self]] = TRUE]
                       /\ bSt' = StopBr(bSt, sBr[pprev[self]])
                  ELSE /\ TRUE
                       /\ UNCHANGED << sCanc, bSt >>
            /\ pc' = [pc EXCEPT ![self] = "P3"]
            /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sClient, 
                            sBr, sProven, sOwner, gcPend, nBr, bCb, bSess, 
                            bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, faults, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, stack, ps, 
                            pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                            perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

P3(self) == /\ pc[self] = "P3"
            /\ \/ /\ sCanc[ps[self]] \/ ~Reach \/ (EnPrepFail /\ faults < MaxFaults)
                  /\ IF ~(sCanc[ps[self]] \/ ~Reach)
                        THEN /\ faults' = faults + 1
                        ELSE /\ TRUE
                             /\ UNCHANGED faults
                  /\ IF eCur = ps[self] /\ eSt = "PREPARING"
                        THEN /\ eCur' = 0
                             /\ eSt' = "STOPPED"
                        ELSE /\ TRUE
                             /\ UNCHANGED << eSt, eCur >>
                  /\ sCanc' = [sCanc EXCEPT ![ps[self]] = TRUE]
                  /\ ret' = [ret EXCEPT ![self] = "err"]
                  /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                  /\ ps' = [ps EXCEPT ![self] = Head(stack[self]).ps]
                  /\ pprev' = [pprev EXCEPT ![self] = Head(stack[self]).pprev]
                  /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
               \/ /\ Reach /\ ~sCanc[ps[self]]
                  /\ TRUE
                  /\ pc' = [pc EXCEPT ![self] = "P5"]
                  /\ UNCHANGED <<eSt, eCur, sCanc, ret, faults, stack, ps, pprev>>
            /\ UNCHANGED << stopping, hAge, disco, nSess, sClient, sBr, 
                            sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                            bTun, cbSt, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, tun, as, ab, 
                            ss, shI, shM, shEp, shSG, bx, perm, psnap, pg, 
                            nsnap, nok, ng, it, mi, mgo >>

P5(self) == /\ pc[self] = "P5"
            /\ IF eCur # ps[self] \/ sCanc[ps[self]]
                  THEN /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ ps' = [ps EXCEPT ![self] = Head(stack[self]).ps]
                       /\ pprev' = [pprev EXCEPT ![self] = Head(stack[self]).pprev]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                       /\ UNCHANGED << eSt, sClient >>
                  ELSE /\ sClient' = [sClient EXCEPT ![ps[self]] = TRUE]
                       /\ eSt' = "PREPARED"
                       /\ ret' = [ret EXCEPT ![self] = "ok"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ ps' = [ps EXCEPT ![self] = Head(stack[self]).ps]
                       /\ pprev' = [pprev EXCEPT ![self] = Head(stack[self]).pprev]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
            /\ UNCHANGED << eCur, stopping, hAge, disco, nSess, sCanc, sBr, 
                            sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                            bTun, cbSt, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, faults, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, tun, as, ab, 
                            ss, shI, shM, shEp, shSG, bx, perm, psnap, pg, 
                            nsnap, nok, ng, it, mi, mgo >>

Prepare(self) == P1(self) \/ P2(self) \/ P3(self) \/ P5(self)

A1(self) == /\ pc[self] = "A1"
            /\ IF eCur = 0 \/ ~(eSt \in {"PREPARED", "RUNNING"})
                  THEN /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                       /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                       /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                       /\ UNCHANGED << eSt, sBr, bSt, bCb >>
                  ELSE /\ IF ~sClient[eCur]
                             THEN /\ ret' = [ret EXCEPT ![self] = "err"]
                                  /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                                  /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                                  /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                                  /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                                  /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                                  /\ UNCHANGED << eSt, sBr, bSt, bCb >>
                             ELSE /\ as' = [as EXCEPT ![self] = eCur]
                                  /\ bCb' = CbOff(bCb, sBr[eCur])
                                  /\ bSt' = StopBr(bSt, sBr[eCur])
                                  /\ sBr' = [sBr EXCEPT ![eCur] = 0]
                                  /\ eSt' = "ATTACHING"
                                  /\ pc' = [pc EXCEPT ![self] = "A3"]
                                  /\ UNCHANGED << ret, stack, tun, ab >>
            /\ UNCHANGED << eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                            sProven, sOwner, gcPend, nBr, bSess, bTun, cbSt, 
                            nTun, tunKind, androidOpen, osCur, nInst, instUp, 
                            shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                            casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                            lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, 
                            jEp, jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                            jSnapSess, ui, uiSess, sessLive, gen, handler, 
                            vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                            rcH, rcT, rcE, netRestore, netGen, intents, net, 
                            gw, faults, starts, discs, badTicks, prepAfterShut, 
                            staleStop, boundHit, ps, pprev, ss, shI, shM, shEp, 
                            shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                            mgo >>

A3(self) == /\ pc[self] = "A3"
            /\ IF sCanc[as[self]]
                  THEN /\ eSt' = AbandonAttach
                       /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                       /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                       /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                  ELSE /\ pc' = [pc EXCEPT ![self] = "A4"]
                       /\ UNCHANGED << eSt, ret, stack, tun, as, ab >>
            /\ UNCHANGED << eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                            sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                            bTun, cbSt, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, faults, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, ps, pprev, ss, 
                            shI, shM, shEp, shSG, bx, perm, psnap, pg, nsnap, 
                            nok, ng, it, mi, mgo >>

A4(self) == /\ pc[self] = "A4"
            /\ \/ /\ EnAttachFail /\ faults < MaxFaults
                  /\ faults' = faults + 1
                  /\ eSt' = AbandonAttach
                  /\ ret' = [ret EXCEPT ![self] = "err"]
                  /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                  /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                  /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                  /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                  /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                  /\ UNCHANGED <<nBr, bSt, bCb, bSess, bTun, boundHit>>
               \/ /\ IF nBr < MaxBr
                        THEN /\ ab' = [ab EXCEPT ![self] = nBr + 1]
                             /\ bSt' = [bSt   EXCEPT ![nBr + 1] = "new"]
                             /\ bCb' = [bCb   EXCEPT ![nBr + 1] = TRUE]
                             /\ bSess' = [bSess EXCEPT ![nBr + 1] = as[self]]
                             /\ bTun' = [bTun  EXCEPT ![nBr + 1] = tun[self]]
                             /\ nBr' = nBr + 1
                             /\ pc' = [pc EXCEPT ![self] = "A5"]
                             /\ UNCHANGED << eSt, ret, boundHit, stack, tun, 
                                             as >>
                        ELSE /\ boundHit' = TRUE
                             /\ eSt' = AbandonAttach
                             /\ ret' = [ret EXCEPT ![self] = "err"]
                             /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                             /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                             /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                             /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                             /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                             /\ UNCHANGED << nBr, bSt, bCb, bSess, bTun >>
                  /\ UNCHANGED faults
            /\ UNCHANGED << eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                            sBr, sProven, sOwner, gcPend, cbSt, nTun, tunKind, 
                            androidOpen, osCur, nInst, instUp, shut, ep, vpnIf, 
                            startJob, sdReq, sdGen, sGen, casGen, doneGen, 
                            finReq, dReq, nsRun, pendNS, lastJob, nJob, jobOn, 
                            jDone, jCanc, jKind, jInst, jEp, jRetry, jPrev, 
                            jExc, jW, jWown, jR, jRown, jSnapSess, ui, uiSess, 
                            sessLive, gen, handler, vpnWanted, pollOn, pollDue, 
                            pollStale, pollGen, rcH, rcT, rcE, netRestore, 
                            netGen, intents, net, gw, starts, discs, badTicks, 
                            prepAfterShut, staleStop, ps, pprev, ss, shI, shM, 
                            shEp, shSG, bx, perm, psnap, pg, nsnap, nok, ng, 
                            it, mi, mgo >>

A5(self) == /\ pc[self] = "A5"
            /\ IF GuardIdentity /\ (eCur # as[self] \/ sCanc[as[self]])
                  THEN /\ bSt' = StopBr(bSt, ab[self])
                       /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                       /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                       /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                       /\ UNCHANGED << eSt, sBr >>
                  ELSE /\ sBr' = [sBr EXCEPT ![as[self]] = ab[self]]
                       /\ eSt' = "ATTACHING"
                       /\ pc' = [pc EXCEPT ![self] = "A6"]
                       /\ UNCHANGED << bSt, ret, stack, tun, as, ab >>
            /\ UNCHANGED << eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                            sProven, sOwner, gcPend, nBr, bCb, bSess, bTun, 
                            cbSt, nTun, tunKind, androidOpen, osCur, nInst, 
                            instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, 
                            sGen, casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                            lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, 
                            jEp, jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                            jSnapSess, ui, uiSess, sessLive, gen, handler, 
                            vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                            rcH, rcT, rcE, netRestore, netGen, intents, net, 
                            gw, faults, starts, discs, badTicks, prepAfterShut, 
                            staleStop, boundHit, ps, pprev, ss, shI, shM, shEp, 
                            shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                            mgo >>

A6(self) == /\ pc[self] = "A6"
            /\ IF bSt[ab[self]] = "new"
                  THEN /\ bSt' = [bSt EXCEPT ![ab[self]] = "up"]
                       /\ disco' = "ok"
                  ELSE /\ TRUE
                       /\ UNCHANGED << disco, bSt >>
            /\ pc' = [pc EXCEPT ![self] = "A7"]
            /\ UNCHANGED << eSt, eCur, stopping, hAge, nSess, sCanc, sClient, 
                            sBr, sProven, sOwner, gcPend, nBr, bCb, bSess, 
                            bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, faults, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, stack, ps, 
                            pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                            perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

A7(self) == /\ pc[self] = "A7"
            /\ IF bSt[ab[self]] = "up" /\ ~sCanc[as[self]]
                  THEN /\ TRUE
                       /\ pc' = [pc EXCEPT ![self] = "A8"]
                       /\ UNCHANGED << eSt, sBr, bSt, ret, stack, tun, as, ab >>
                  ELSE /\ IF eCur = as[self] /\ sBr[as[self]] = ab[self]
                             THEN /\ sBr' = [sBr EXCEPT ![as[self]] = 0]
                                  /\ eSt' = AbandonAttach
                             ELSE /\ TRUE
                                  /\ UNCHANGED << eSt, sBr >>
                       /\ bSt' = [bSt EXCEPT ![ab[self]] = "stopped"]
                       /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                       /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                       /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
            /\ UNCHANGED << eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                            sProven, sOwner, gcPend, nBr, bCb, bSess, bTun, 
                            cbSt, nTun, tunKind, androidOpen, osCur, nInst, 
                            instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, 
                            sGen, casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                            lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, 
                            jEp, jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                            jSnapSess, ui, uiSess, sessLive, gen, handler, 
                            vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                            rcH, rcT, rcE, netRestore, netGen, intents, net, 
                            gw, faults, starts, discs, badTicks, prepAfterShut, 
                            staleStop, boundHit, ps, pprev, ss, shI, shM, shEp, 
                            shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                            mgo >>

A8(self) == /\ pc[self] = "A8"
            /\ IF GuardIdentity /\ (eCur # as[self] \/ sCanc[as[self]])
                  THEN /\ bSt' = StopBr(bSt, ab[self])
                       /\ ret' = [ret EXCEPT ![self] = "err"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                       /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                       /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                       /\ UNCHANGED << eSt, hAge, sProven >>
                  ELSE /\ IF eSt = "FAILED"
                             THEN /\ ret' = [ret EXCEPT ![self] = "err"]
                                  /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                                  /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                                  /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                                  /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                                  /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                                  /\ UNCHANGED << eSt, hAge, sProven, bSt >>
                             ELSE /\ IF GuardIdentity /\ sBr[as[self]] # ab[self]
                                        THEN /\ bSt' = StopBr(bSt, ab[self])
                                             /\ ret' = [ret EXCEPT ![self] = "err"]
                                             /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                                             /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                                             /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                                             /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                                             /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                                             /\ UNCHANGED << eSt, hAge, 
                                                             sProven >>
                                        ELSE /\ eSt' = "RUNNING"
                                             /\ hAge' = 0
                                             /\ sProven' = [sProven EXCEPT ![as[self]] = TRUE]
                                             /\ ret' = [ret EXCEPT ![self] = "ok"]
                                             /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                                             /\ as' = [as EXCEPT ![self] = Head(stack[self]).as]
                                             /\ ab' = [ab EXCEPT ![self] = Head(stack[self]).ab]
                                             /\ tun' = [tun EXCEPT ![self] = Head(stack[self]).tun]
                                             /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                                             /\ bSt' = bSt
            /\ UNCHANGED << eCur, stopping, disco, nSess, sCanc, sClient, sBr, 
                            sOwner, gcPend, nBr, bCb, bSess, bTun, cbSt, nTun, 
                            tunKind, androidOpen, osCur, nInst, instUp, shut, 
                            ep, vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                            doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                            nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                            jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                            jSnapSess, ui, uiSess, sessLive, gen, handler, 
                            vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                            rcH, rcT, rcE, netRestore, netGen, intents, net, 
                            gw, faults, starts, discs, badTicks, prepAfterShut, 
                            staleStop, boundHit, ps, pprev, ss, shI, shM, shEp, 
                            shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                            mgo >>

AttachTun(self) == A1(self) \/ A3(self) \/ A4(self) \/ A5(self) \/ A6(self)
                      \/ A7(self) \/ A8(self)

S1(self) == /\ pc[self] = "S1"
            /\ IF eSt = "STOPPED" /\ ~stopping
                  THEN /\ ret' = [ret EXCEPT ![self] = "ok"]
                       /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                       /\ ss' = [ss EXCEPT ![self] = Head(stack[self]).ss]
                       /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                       /\ UNCHANGED << eSt, eCur, stopping, hAge >>
                  ELSE /\ IF stopping
                             THEN /\ pc' = [pc EXCEPT ![self] = "SWait"]
                                  /\ UNCHANGED << eSt, eCur, stopping, hAge, 
                                                  ss >>
                             ELSE /\ stopping' = TRUE
                                  /\ ss' = [ss EXCEPT ![self] = eCur]
                                  /\ eCur' = 0
                                  /\ eSt' = "STOPPING"
                                  /\ hAge' = -1
                                  /\ pc' = [pc EXCEPT ![self] = "S2"]
                       /\ UNCHANGED << ret, stack >>
            /\ UNCHANGED << disco, nSess, sCanc, sClient, sBr, sProven, sOwner, 
                            gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, nTun, 
                            tunKind, androidOpen, osCur, nInst, instUp, shut, 
                            ep, vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                            doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                            nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                            jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                            jSnapSess, ui, uiSess, sessLive, gen, handler, 
                            vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                            rcH, rcT, rcE, netRestore, netGen, intents, net, 
                            gw, faults, starts, discs, badTicks, prepAfterShut, 
                            staleStop, boundHit, ps, pprev, tun, as, ab, shI, 
                            shM, shEp, shSG, bx, perm, psnap, pg, nsnap, nok, 
                            ng, it, mi, mgo >>

S2(self) == /\ pc[self] = "S2"
            /\ IF ss[self] # 0
                  THEN /\ sCanc' = [sCanc EXCEPT ![ss[self]] = TRUE]
                       /\ bSt' = StopBr(bSt, sBr[ss[self]])
                  ELSE /\ TRUE
                       /\ UNCHANGED << sCanc, bSt >>
            /\ pc' = [pc EXCEPT ![self] = "S3"]
            /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sClient, 
                            sBr, sProven, sOwner, gcPend, nBr, bCb, bSess, 
                            bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, faults, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, stack, ps, 
                            pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                            perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

S3(self) == /\ pc[self] = "S3"
            /\ eSt' = "STOPPED"
            /\ stopping' = FALSE
            /\ ret' = [ret EXCEPT ![self] = "ok"]
            /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
            /\ ss' = [ss EXCEPT ![self] = Head(stack[self]).ss]
            /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
            /\ UNCHANGED << eCur, hAge, disco, nSess, sCanc, sClient, sBr, 
                            sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                            bTun, cbSt, nTun, tunKind, androidOpen, osCur, 
                            nInst, instUp, shut, ep, vpnIf, startJob, sdReq, 
                            sdGen, sGen, casGen, doneGen, finReq, dReq, nsRun, 
                            pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                            jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                            jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                            handler, vpnWanted, pollOn, pollDue, pollStale, 
                            pollGen, rcH, rcT, rcE, netRestore, netGen, 
                            intents, net, gw, faults, starts, discs, badTicks, 
                            prepAfterShut, staleStop, boundHit, ps, pprev, tun, 
                            as, ab, shI, shM, shEp, shSG, bx, perm, psnap, pg, 
                            nsnap, nok, ng, it, mi, mgo >>

SWait(self) == /\ pc[self] = "SWait"
               /\ ~stopping
               /\ ret' = [ret EXCEPT ![self] = "ok"]
               /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
               /\ ss' = [ss EXCEPT ![self] = Head(stack[self]).ss]
               /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
               /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                               sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                               bCb, bSess, bTun, cbSt, nTun, tunKind, 
                               androidOpen, osCur, nInst, instUp, shut, ep, 
                               vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                               doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                               nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                               jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                               jSnapSess, ui, uiSess, sessLive, gen, handler, 
                               vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                               rcH, rcT, rcE, netRestore, netGen, intents, net, 
                               gw, faults, starts, discs, badTicks, 
                               prepAfterShut, staleStop, boundHit, ps, pprev, 
                               tun, as, ab, shI, shM, shEp, shSG, bx, perm, 
                               psnap, pg, nsnap, nok, ng, it, mi, mgo >>

Stop(self) == S1(self) \/ S2(self) \/ S3(self) \/ SWait(self)

SHc(self) == /\ pc[self] = "SHc"
             /\ IF shut[shI[self]] \/ (shEp[self] # -1 /\ ep[shI[self]] # shEp[self]) \/ (shSG[self] # -1 /\ sGen[shI[self]] # shSG[self])
                   THEN /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
                        /\ shI' = [shI EXCEPT ![self] = Head(stack[self]).shI]
                        /\ shM' = [shM EXCEPT ![self] = Head(stack[self]).shM]
                        /\ shEp' = [shEp EXCEPT ![self] = Head(stack[self]).shEp]
                        /\ shSG' = [shSG EXCEPT ![self] = Head(stack[self]).shSG]
                        /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
                        /\ UNCHANGED << shut, ep, casGen >>
                   ELSE /\ shut' = [shut EXCEPT ![shI[self]] = TRUE]
                        /\ ep' = [ep EXCEPT ![shI[self]] = ep[shI[self]] + 1]
                        /\ casGen' = [casGen EXCEPT ![shI[self]] = sGen[shI[self]]]
                        /\ pc' = [pc EXCEPT ![self] = "SH1"]
                        /\ UNCHANGED << stack, shI, shM, shEp, shSG >>
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                             bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
                             androidOpen, osCur, nInst, instUp, vpnIf, 
                             startJob, sdReq, sdGen, sGen, doneGen, finReq, 
                             dReq, nsRun, pendNS, lastJob, nJob, jobOn, jDone, 
                             jCanc, jKind, jInst, jEp, jRetry, jPrev, jExc, jW, 
                             jWown, jR, jRown, jSnapSess, ui, uiSess, sessLive, 
                             gen, handler, vpnWanted, pollOn, pollDue, 
                             pollStale, pollGen, rcH, rcT, rcE, netRestore, 
                             netGen, intents, net, gw, faults, starts, discs, 
                             badTicks, prepAfterShut, staleStop, boundHit, ps, 
                             pprev, tun, as, ab, ss, bx, perm, psnap, pg, 
                             nsnap, nok, ng, it, mi, mgo >>

SH1(self) == /\ pc[self] = "SH1"
             /\ handler' = 0
             /\ IF startJob[shI[self]] # 0
                   THEN /\ jCanc' = [jCanc EXCEPT ![startJob[shI[self]]] = TRUE]
                   ELSE /\ TRUE
                        /\ jCanc' = jCanc
             /\ pollOn' = FALSE
             /\ pc' = [pc EXCEPT ![self] = "SH2"]
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                             bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
                             androidOpen, osCur, nInst, instUp, shut, ep, 
                             vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                             doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                             nJob, jobOn, jDone, jKind, jInst, jEp, jRetry, 
                             jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, ui, 
                             uiSess, sessLive, gen, vpnWanted, pollDue, 
                             pollStale, pollGen, rcH, rcT, rcE, netRestore, 
                             netGen, intents, net, gw, faults, starts, discs, 
                             badTicks, prepAfterShut, staleStop, boundHit, 
                             stack, ps, pprev, tun, as, ab, ss, shI, shM, shEp, 
                             shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                             mgo >>

SH2(self) == /\ pc[self] = "SH2"
             /\ androidOpen' = CloseT(androidOpen, vpnIf[shI[self]])
             /\ vpnIf' = [vpnIf EXCEPT ![shI[self]] = 0]
             /\ pc' = [pc EXCEPT ![self] = "SH3"]
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                             bCb, bSess, bTun, cbSt, ret, nTun, tunKind, osCur, 
                             nInst, instUp, shut, ep, startJob, sdReq, sdGen, 
                             sGen, casGen, doneGen, finReq, dReq, nsRun, 
                             pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                             jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                             jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                             handler, vpnWanted, pollOn, pollDue, pollStale, 
                             pollGen, rcH, rcT, rcE, netRestore, netGen, 
                             intents, net, gw, faults, starts, discs, badTicks, 
                             prepAfterShut, staleStop, boundHit, stack, ps, 
                             pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                             perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

SH3(self) == /\ pc[self] = "SH3"
             /\ IF shM[self] = "sync"
                   THEN /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Stop",
                                                                 pc        |->  "SH4",
                                                                 ss        |->  ss[self] ] >>
                                                             \o stack[self]]
                        /\ ss' = [ss EXCEPT ![self] = 0]
                        /\ pc' = [pc EXCEPT ![self] = "S1"]
                        /\ UNCHANGED << nsRun, pendNS >>
                   ELSE /\ pendNS' = shI[self]
                        /\ nsRun' = [nsRun EXCEPT ![shI[self]] = TRUE]
                        /\ pc' = [pc EXCEPT ![self] = "SH4"]
                        /\ UNCHANGED << stack, ss >>
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                             bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
                             androidOpen, osCur, nInst, instUp, shut, ep, 
                             vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                             doneGen, finReq, dReq, lastJob, nJob, jobOn, 
                             jDone, jCanc, jKind, jInst, jEp, jRetry, jPrev, 
                             jExc, jW, jWown, jR, jRown, jSnapSess, ui, uiSess, 
                             sessLive, gen, handler, vpnWanted, pollOn, 
                             pollDue, pollStale, pollGen, rcH, rcT, rcE, 
                             netRestore, netGen, intents, net, gw, faults, 
                             starts, discs, badTicks, prepAfterShut, staleStop, 
                             boundHit, ps, pprev, tun, as, ab, shI, shM, shEp, 
                             shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                             mgo >>

SH4(self) == /\ pc[self] = "SH4"
             /\ IF shM[self] = "sync"
                   THEN /\ finReq' = [finReq EXCEPT ![shI[self]] = TRUE]
                        /\ UNCHANGED << instUp, doneGen, ui, uiSess, sessLive, 
                                        gen, pollOn >>
                   ELSE /\ doneGen' = [doneGen EXCEPT ![shI[self]] = casGen[shI[self]]]
                        /\ sessLive' = FALSE
                        /\ gen' = gen + 1
                        /\ pollOn' = FALSE
                        /\ ui' = "DISCONNECTED"
                        /\ uiSess' = 0
                        /\ instUp' = [instUp EXCEPT ![shI[self]] = FALSE]
                        /\ UNCHANGED finReq
             /\ pc' = [pc EXCEPT ![self] = Head(stack[self]).pc]
             /\ shI' = [shI EXCEPT ![self] = Head(stack[self]).shI]
             /\ shM' = [shM EXCEPT ![self] = Head(stack[self]).shM]
             /\ shEp' = [shEp EXCEPT ![self] = Head(stack[self]).shEp]
             /\ shSG' = [shSG EXCEPT ![self] = Head(stack[self]).shSG]
             /\ stack' = [stack EXCEPT ![self] = Tail(stack[self])]
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                             bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
                             androidOpen, osCur, nInst, shut, ep, vpnIf, 
                             startJob, sdReq, sdGen, sGen, casGen, dReq, nsRun, 
                             pendNS, lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                             jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                             jRown, jSnapSess, handler, vpnWanted, pollDue, 
                             pollStale, pollGen, rcH, rcT, rcE, netRestore, 
                             netGen, intents, net, gw, faults, starts, discs, 
                             badTicks, prepAfterShut, staleStop, boundHit, ps, 
                             pprev, tun, as, ab, ss, bx, perm, psnap, pg, 
                             nsnap, nok, ng, it, mi, mgo >>

Shutdown(self) == SHc(self) \/ SH1(self) \/ SH2(self) \/ SH3(self)
                     \/ SH4(self)

BPL(self) == /\ pc[self] = "BPL"
             /\ pc' = [pc EXCEPT ![self] = "BPw"]
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                             bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
                             androidOpen, osCur, nInst, instUp, shut, ep, 
                             vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                             doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                             nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                             jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                             jSnapSess, ui, uiSess, sessLive, gen, handler, 
                             vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                             rcH, rcT, rcE, netRestore, netGen, intents, net, 
                             gw, faults, starts, discs, badTicks, 
                             prepAfterShut, staleStop, boundHit, stack, ps, 
                             pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                             perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

BPw(self) == /\ pc[self] = "BPw"
             /\ \/ /\ EnPump /\ bx[self] \in PumpBr /\ bSt[bx[self]] = "up" /\ ~sCanc[bSess[bx[self]]] /\ faults < MaxFaults
                   /\ faults' = faults + 1
                   /\ bSt' = [bSt EXCEPT ![bx[self]] = "dead"]
                   /\ IF bCb[bx[self]]
                         THEN /\ IF Mut("F1")
                                    THEN /\ cbSt' = [cbSt EXCEPT ![bx[self]] = "chk"]
                                         /\ UNCHANGED << eSt, hAge, gcPend >>
                                    ELSE /\ IF SplitCb
                                               THEN /\ cbSt' = [cbSt EXCEPT ![bx[self]] = "mark"]
                                                    /\ UNCHANGED << eSt, hAge, 
                                                                    gcPend >>
                                               ELSE /\ IF eCur = bSess[bx[self]] /\ sBr[bSess[bx[self]]] = bx[self] /\ eSt \in {"RUNNING", "ATTACHING"}
                                                          THEN /\ eSt' = "FAILED"
                                                               /\ hAge' = -1
                                                               /\ gcPend' = [gcPend EXCEPT ![bSess[bx[self]]] = TRUE]
                                                          ELSE /\ TRUE
                                                               /\ UNCHANGED << eSt, 
                                                                               hAge, 
                                                                               gcPend >>
                                                    /\ cbSt' = cbSt
                         ELSE /\ TRUE
                              /\ UNCHANGED << eSt, hAge, gcPend, cbSt >>
                \/ /\ cbSt[bx[self]] = "chk"
                   /\ IF eCur = bSess[bx[self]] /\ sBr[bSess[bx[self]]] = bx[self]
                         THEN /\ cbSt' = [cbSt EXCEPT ![bx[self]] = "mark"]
                         ELSE /\ cbSt' = [cbSt EXCEPT ![bx[self]] = "none"]
                   /\ UNCHANGED <<eSt, hAge, gcPend, bSt, faults>>
                \/ /\ cbSt[bx[self]] = "mark"
                   /\ IF (eCur = bSess[bx[self]] \/ ~GuardMarkFailed) /\ eSt \in {"RUNNING", "ATTACHING"}
                         /\ (Mut("F1") \/ sBr[bSess[bx[self]]] = bx[self])
                         THEN /\ eSt' = "FAILED"
                              /\ hAge' = -1
                              /\ gcPend' = [gcPend EXCEPT ![bSess[bx[self]]] = TRUE]
                         ELSE /\ TRUE
                              /\ UNCHANGED << eSt, hAge, gcPend >>
                   /\ cbSt' = [cbSt EXCEPT ![bx[self]] = "none"]
                   /\ UNCHANGED <<bSt, faults>>
             /\ pc' = [pc EXCEPT ![self] = "BPL"]
