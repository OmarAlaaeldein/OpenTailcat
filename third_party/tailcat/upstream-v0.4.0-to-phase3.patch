+// Exit node capability flags advertised in Meowed acknowledgment packet.
+const (
+	CapExitTCP uint8 = 1 << 0 // 0x01: Server supports exit-node TCP forwarding
+	CapExitUDP uint8 = 1 << 1 // 0x02: Server supports exit-node UDP forwarding
+)
+
 // IsMeowedPacket reports whether pkt is a meowed (acknowledgment) packet.
 func IsMeowedPacket(pkt []byte) bool {
 	return len(pkt) >= 5 && [4]byte(pkt[:4]) == meowMagic && pkt[4] == meowTypePong
 }
+
+// EncodeMeowedWithCaps encodes a meowed (acknowledgment) packet with versioned capabilities.
+func EncodeMeowedWithCaps(caps uint8) []byte {
+	b := make([]byte, 0, 4+1+1)
+	b = append(b, meowMagic[:]...)
+	b = append(b, meowTypePong, caps)
+	return b
+}
+
+// ParseMeowedCaps parses capability flags from a meowed acknowledgment packet.
+// Legacy servers that send 5-byte meowed without capability trailer return 0.
+func ParseMeowedCaps(pkt []byte) uint8 {
+	if len(pkt) >= 6 && IsMeowedPacket(pkt) {
+		return pkt[5]
+	}
+	return 0
+}
