MR == /\ pc[3000] = "MR"
      /\ IF mi # 0
            THEN /\ TRUE
                 /\ UNCHANGED << nInst, instUp, shut, boundHit, mi >>
            ELSE /\ IF \E x \in Inst : instUp[x]
                       THEN /\ mi' = (CHOOSE x \in Inst : instUp[x])
                            /\ UNCHANGED << nInst, instUp, shut, boundHit >>
                       ELSE /\ IF it \in {"REVOKE", "DESTROY"}
                                  THEN /\ mi' = 0
                                       /\ UNCHANGED << nInst, instUp, shut, 
                                                       boundHit >>
                                  ELSE /\ IF nInst < MaxInst
                                             THEN /\ mi' = nInst + 1
                                                  /\ instUp' = [instUp EXCEPT ![nInst + 1] = TRUE]
                                                  /\ shut' = [shut   EXCEPT ![nInst + 1] = FALSE]
                                                  /\ nInst' = nInst + 1
                                                  /\ UNCHANGED boundHit
                                             ELSE /\ boundHit' = TRUE
                                                  /\ mi' = 0
                                                  /\ UNCHANGED << nInst, 
                                                                  instUp, shut >>
      /\ pc' = [pc EXCEPT ![3000] = "MS"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, ep, vpnIf, 
                      startJob, sdReq, sdGen, sGen, casGen, doneGen, finReq, 
                      dReq, nsRun, pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                      jKind, jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                      jRown, jSnapSess, ui, uiSess, sessLive, gen, handler, 
                      vpnWanted, pollOn, pollDue, pollStale, pollGen, rcH, rcT, 
                      rcE, netRestore, netGen, intents, net, gw, faults, 
                      starts, discs, badTicks, prepAfterShut, staleStop, stack, 
                      ps, pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                      perm, psnap, pg, nsnap, nok, ng, it, mgo >>

MS == /\ pc[3000] = "MS"
      /\ IF mi = 0
            THEN /\ TRUE
                 /\ pc' = [pc EXCEPT ![3000] = "MS2"]
                 /\ UNCHANGED << instUp, shut, sdReq, sdGen, sGen, dReq, ui, 
                                 uiSess, vpnWanted, stack, shI, shM, shEp, 
                                 shSG, mgo >>
            ELSE /\ IF it = "REVOKE"
                       THEN /\ vpnWanted' = FALSE
                            /\ sdReq' = [sdReq EXCEPT ![mi] = TRUE]
                            /\ sdGen' = [sdGen EXCEPT ![mi] = -1]
                            /\ pc' = [pc EXCEPT ![3000] = "MS2"]
                            /\ UNCHANGED << instUp, shut, sGen, dReq, ui, 
                                            uiSess, stack, shI, shM, shEp, 
                                            shSG, mgo >>
                       ELSE /\ IF it \in {"DESTROY", "DESTROYED"}
                                  THEN /\ instUp' = [instUp EXCEPT ![mi] = FALSE]
                                       /\ IF ~shut[mi]
                                             THEN /\ /\ shEp' = [shEp EXCEPT ![3000] = -1]
                                                     /\ shI' = [shI EXCEPT ![3000] = mi]
                                                     /\ shM' = [shM EXCEPT ![3000] = "async"]
                                                     /\ shSG' = [shSG EXCEPT ![3000] = -1]
                                                     /\ stack' = [stack EXCEPT ![3000] = << [ procedure |->  "Shutdown",
                                                                                              pc        |->  "MS2",
                                                                                              shI       |->  shI[3000],
                                                                                              shM       |->  shM[3000],
                                                                                              shEp      |->  shEp[3000],
                                                                                              shSG      |->  shSG[3000] ] >>
                                                                                          \o stack[3000]]
                                                  /\ pc' = [pc EXCEPT ![3000] = "SHc"]
                                             ELSE /\ pc' = [pc EXCEPT ![3000] = "MS2"]
                                                  /\ UNCHANGED << stack, shI, 
                                                                  shM, shEp, 
                                                                  shSG >>
                                       /\ UNCHANGED << shut, sdReq, sdGen, 
                                                       sGen, dReq, ui, uiSess, 
                                                       vpnWanted, mgo >>
                                  ELSE /\ IF it = "STOP"
                                             THEN /\ IF Mut("F7")
                                                        THEN /\ vpnWanted' = FALSE
                                                        ELSE /\ TRUE
                                                             /\ UNCHANGED vpnWanted
                                                  /\ IF Mut("N1b")
                                                        THEN /\ sdReq' = [sdReq EXCEPT ![mi] = TRUE]
                                                             /\ sdGen' = [sdGen EXCEPT ![mi] = -1]
                                                             /\ UNCHANGED << instUp, 
                                                                             dReq >>
                                                        ELSE /\ IF sGen[mi] = doneGen[mi]
                                                                   THEN /\ IF ~PendingStart
                                                                              THEN /\ instUp' = [instUp EXCEPT ![mi] = FALSE]
                                                                                   /\ dReq' = [dReq   EXCEPT ![mi] = EnOnDestroy]
                                                                              ELSE /\ TRUE
                                                                                   /\ UNCHANGED << instUp, 
                                                                                                   dReq >>
                                                                        /\ UNCHANGED << sdReq, 
                                                                                        sdGen >>
                                                                   ELSE /\ IF shut[mi] \/ vpnWanted'
                                                                              THEN /\ TRUE
                                                                                   /\ UNCHANGED << sdReq, 
                                                                                                   sdGen >>
                                                                              ELSE /\ sdReq' = [sdReq EXCEPT ![mi] = TRUE]
                                                                                   /\ sdGen' = [sdGen EXCEPT ![mi] = IF sdReq'[mi] /\ sdGen[mi] = -1 THEN -1 ELSE sGen[mi]]
                                                                        /\ UNCHANGED << instUp, 
                                                                                        dReq >>
                                                  /\ UNCHANGED << shut, sGen, 
                                                                  ui, uiSess, 
                                                                  mgo >>
                                             ELSE /\ IF (Mut("Dup") \/ ~shut[mi]) /\ (JobActive(startJob[mi]) \/ vpnIf[mi] # 0)
                                                        THEN /\ TRUE
                                                             /\ UNCHANGED << shut, 
                                                                             sGen, 
                                                                             ui, 
                                                                             uiSess, 
                                                                             vpnWanted, 
                                                                             mgo >>
                                                        ELSE /\ IF it = "AO"
                                                                   THEN /\ vpnWanted' = TRUE
                                                                   ELSE /\ TRUE
                                                                        /\ UNCHANGED vpnWanted
                                                             /\ shut' = [shut EXCEPT ![mi] = FALSE]
                                                             /\ sGen' = [sGen EXCEPT ![mi] = sGen[mi] + 1]
                                                             /\ ui' = "CONNECTING"
                                                             /\ uiSess' = 0
                                                             /\ mgo' = TRUE
                                                  /\ UNCHANGED << instUp, 
                                                                  sdReq, sdGen, 
                                                                  dReq >>
                                       /\ pc' = [pc EXCEPT ![3000] = "MS2"]
                                       /\ UNCHANGED << stack, shI, shM, shEp, 
                                                       shSG >>
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, ep, 
                      vpnIf, startJob, casGen, doneGen, finReq, nsRun, pendNS, 
                      lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                      jRetry, jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, 
                      sessLive, gen, handler, pollOn, pollDue, pollStale, 
                      pollGen, rcH, rcT, rcE, netRestore, netGen, intents, net, 
                      gw, faults, starts, discs, badTicks, prepAfterShut, 
                      staleStop, boundHit, ps, pprev, tun, as, ab, ss, bx, 
                      perm, psnap, pg, nsnap, nok, ng, it, mi >>

MS2 == /\ pc[3000] = "MS2"
       /\ IF mgo
             THEN /\ mgo' = FALSE
                  /\ IF nJob < MaxJobs
                        THEN /\ jobOn' = [jobOn  EXCEPT ![nJob + 1] = TRUE]
                             /\ jKind' = [jKind  EXCEPT ![nJob + 1] = "start"]
                             /\ jInst' = [jInst  EXCEPT ![nJob + 1] = mi]
                             /\ jRetry' = [jRetry EXCEPT ![nJob + 1] = ((it # "USER"))]
                             /\ jEp' = [jEp    EXCEPT ![nJob + 1] = ep[mi]]
                             /\ jPrev' = [jPrev  EXCEPT ![nJob + 1] = (IF Mut("Serial") THEN 0 ELSE lastJob)]
                             /\ startJob' = [startJob EXCEPT ![mi] = nJob + 1]
                             /\ lastJob' = nJob + 1
                             /\ nJob' = nJob + 1
                             /\ UNCHANGED boundHit
                        ELSE /\ boundHit' = TRUE
                             /\ UNCHANGED << startJob, lastJob, nJob, jobOn, 
                                             jKind, jInst, jEp, jRetry, jPrev >>
             ELSE /\ TRUE
                  /\ UNCHANGED << startJob, lastJob, nJob, jobOn, jKind, jInst, 
                                  jEp, jRetry, jPrev, boundHit, mgo >>
       /\ pc' = [pc EXCEPT ![3000] = "MEnd"]
       /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                       sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                       bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
                       nInst, instUp, shut, ep, vpnIf, sdReq, sdGen, sGen, 
                       casGen, doneGen, finReq, dReq, nsRun, pendNS, jDone, 
                       jCanc, jExc, jW, jWown, jR, jRown, jSnapSess, ui, 
                       uiSess, sessLive, gen, handler, vpnWanted, pollOn, 
                       pollDue, pollStale, pollGen, rcH, rcT, rcE, netRestore, 
                       netGen, intents, net, gw, faults, starts, discs, 
                       badTicks, prepAfterShut, staleStop, stack, ps, pprev, 
                       tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                       pg, nsnap, nok, ng, it, mi >>

MEnd == /\ pc[3000] = "MEnd"
        /\ it' = ""
        /\ mi' = 0
        /\ pc' = [pc EXCEPT ![3000] = "ML"]
        /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
