                                  psnap, pg, nsnap, nok, ng, it, mi, mgo >>

JEnd(self) == /\ pc[self] = "JEnd"
              /\ jDone' = [jDone EXCEPT ![self] = TRUE]
              /\ pc' = [pc EXCEPT ![self] = "Done"]
              /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                              sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                              bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
