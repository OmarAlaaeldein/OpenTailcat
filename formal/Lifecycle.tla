RetryDelay(self) == /\ pc[self] = "RetryDelay"
                    /\ IF jCanc[self]
                          THEN /\ pc' = [pc EXCEPT ![self] = "JEnd"]
                          ELSE /\ pc' = [pc EXCEPT ![self] = "RetryDelay2"]
                    /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
