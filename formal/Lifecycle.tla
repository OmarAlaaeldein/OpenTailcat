NR2 == /\ pc[1100] = "NR2"
       /\ IF UiRaces
             THEN /\ IF Mut("F6")
                        THEN /\ nok' = (sessLive /\ LiveSnap(nsnap))
                             /\ UNCHANGED << ui, uiSess >>
                        ELSE /\ IF sessLive /\ gen = ng /\ ui = "RECONNECTING" /\ LiveSnap(nsnap)
                                   THEN /\ ui' = "CONNECTED"
                                        /\ uiSess' = nsnap.sess
                                   ELSE /\ TRUE
                                        /\ UNCHANGED << ui, uiSess >>
                             /\ nok' = nok
                  /\ pc' = [pc EXCEPT ![1100] = "NR3"]
             ELSE /\ IF sessLive /\ LiveSnap(Snap) /\ (Mut("F6") \/ (gen = ng /\ ui = "RECONNECTING"))
                        THEN /\ ui' = "CONNECTED"
                             /\ uiSess' = eCur
                        ELSE /\ TRUE
                             /\ UNCHANGED << ui, uiSess >>
                  /\ pc' = [pc EXCEPT ![1100] = "NL"]
                  /\ nok' = nok
       /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                       sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                       bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
