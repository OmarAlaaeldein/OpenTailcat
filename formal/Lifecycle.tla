job(self) == JStart(self) \/ JJoin(self) \/ JKind(self) \/ RChk(self)
                \/ RReset(self) \/ RNote(self) \/ JoinNS(self)
                \/ Loop(self) \/ PrepCall(self) \/ PrepRet(self)
                \/ WarmEst(self) \/ WarmAdopt(self) \/ WarmAttach(self)
                \/ WarmAttachRet(self) \/ WarmSnap(self) \/ Sweep1(self)
                \/ Disarm(self) \/ Detach(self) \/ RoutedEst(self)
                \/ RoutedClear(self) \/ RoutedAdopt(self)
                \/ RoutedAttach(self) \/ RoutedAttachRet(self)
                \/ RoutedSnap(self) \/ PostSweep(self) \/ SetHandler(self)
                \/ Catch(self) \/ CatchPerm(self) \/ CatchDecide(self)
                \/ RetryReset(self) \/ RetryNotify(self)
                \/ RetryDelay(self) \/ RetryDelay2(self) \/ Abandon(self)
                \/ AbShut(self) \/ AbEnd(self) \/ CatchShut(self)
                \/ CatchEnd(self) \/ JEnd(self)

PL == /\ pc[1000] = "PL"
      /\ pc' = [pc EXCEPT ![1000] = "PR"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
                      instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                      casGen, doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                      nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                      jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, ui, uiSess, 
                      sessLive, gen, handler, vpnWanted, pollOn, pollDue, 
                      pollStale, pollGen, rcH, rcT, rcE, netRestore, netGen, 
                      intents, net, gw, faults, starts, discs, badTicks, 
                      prepAfterShut, staleStop, boundHit, stack, ps, pprev, 
                      tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                      pg, nsnap, nok, ng, it, mi, mgo >>

PR == /\ pc[1000] = "PR"
      /\ pollOn /\ (pollDue \/ ~Timed)
      /\ pollDue' = FALSE
      /\ pg' = pollGen
      /\ IF UiRaces
            THEN /\ psnap' = Snap
                 /\ UNCHANGED << ui, uiSess, sessLive, gen, pollOn, pollStale, 
                                 rcH, rcT >>
            ELSE /\ IF Mut("F6") \/ (sessLive /\ gen = pollGen)
                       THEN /\ IF Reason(Snap) \in {"pump", "gw"}
                                  \/ (Timed /\ Reason(Snap) = "stale" /\ pollStale + 1 >= StalePolls)
                                  THEN /\ sessLive' = FALSE
                                       /\ gen' = gen + 1
                                       /\ pollOn' = FALSE
                                       /\ IF handler # 0 /\ vpnWanted
                                             THEN /\ ui' = "RECONNECTING"
                                                  /\ uiSess' = 0
                                             ELSE /\ TRUE
                                                  /\ UNCHANGED << ui, uiSess >>
                                       /\ rcH' = handler
                                       /\ rcT' = TRUE
                                       /\ pollStale' = 0
                                  ELSE /\ IF Reason(Snap) = "stale"
                                             THEN /\ pollStale' = IF Timed THEN pollStale + 1 ELSE 0
                                                  /\ UNCHANGED << ui, uiSess >>
                                             ELSE /\ pollStale' = 0
                                                  /\ ui' = (IF Snap.disco = "stale" THEN "DEGRADED" ELSE "CONNECTED")
                                                  /\ uiSess' = Snap.sess
                                       /\ UNCHANGED << sessLive, gen, pollOn, 
                                                       rcH, rcT >>
                       ELSE /\ TRUE
                            /\ UNCHANGED << ui, uiSess, sessLive, gen, pollOn, 
                                            pollStale, rcH, rcT >>
                 /\ psnap' = psnap
      /\ pc' = [pc EXCEPT ![1000] = "PA"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
                      instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                      casGen, doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                      nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                      jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, handler, 
                      vpnWanted, pollGen, rcE, netRestore, netGen, intents, 
                      net, gw, faults, starts, discs, badTicks, prepAfterShut, 
                      staleStop, boundHit, stack, ps, pprev, tun, as, ab, ss, 
                      shI, shM, shEp, shSG, bx, perm, nsnap, nok, ng, it, mi, 
                      mgo >>

PA == /\ pc[1000] = "PA"
      /\ IF UiRaces
            THEN /\ IF Mut("F6") \/ (sessLive /\ gen = pg)
                       THEN /\ IF Reason(psnap) \in {"pump", "gw"}
                                  \/ (Timed /\ Reason(psnap) = "stale" /\ pollStale + 1 >= StalePolls)
                                  THEN /\ sessLive' = FALSE
                                       /\ gen' = gen + 1
                                       /\ pollOn' = FALSE
                                       /\ IF handler # 0 /\ vpnWanted
                                             THEN /\ ui' = "RECONNECTING"
                                                  /\ uiSess' = 0
                                             ELSE /\ TRUE
                                                  /\ UNCHANGED << ui, uiSess >>
                                       /\ rcH' = handler
                                       /\ rcT' = TRUE
                                       /\ pollStale' = 0
                                  ELSE /\ IF Reason(psnap) = "stale"
                                             THEN /\ pollStale' = IF Timed THEN pollStale + 1 ELSE 0
                                                  /\ UNCHANGED << ui, uiSess >>
                                             ELSE /\ pollStale' = 0
                                                  /\ ui' = (IF psnap.disco = "stale" THEN "DEGRADED" ELSE "CONNECTED")
                                                  /\ uiSess' = psnap.sess
                                       /\ UNCHANGED << sessLive, gen, pollOn, 
                                                       rcH, rcT >>
                       ELSE /\ TRUE
                            /\ UNCHANGED << ui, uiSess, sessLive, gen, pollOn, 
                                            pollStale, rcH, rcT >>
                 /\ psnap' = NoSnap
            ELSE /\ TRUE
                 /\ UNCHANGED << ui, uiSess, sessLive, gen, pollOn, pollStale, 
                                 rcH, rcT, psnap >>
      /\ pc' = [pc EXCEPT ![1000] = "PRc"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
                      instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                      casGen, doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                      nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                      jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, handler, 
                      vpnWanted, pollDue, pollGen, rcE, netRestore, netGen, 
                      intents, net, gw, faults, starts, discs, badTicks, 
                      prepAfterShut, staleStop, boundHit, stack, ps, pprev, 
                      tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, pg, 
                      nsnap, nok, ng, it, mi, mgo >>

PRc == /\ pc[1000] = "PRc"
       /\ IF rcT
             THEN /\ rcT' = FALSE
                  /\ IF rcH # 0 /\ vpnWanted
                        THEN /\ rcE' = ~shut[rcH]
                             /\ UNCHANGED << vpnWanted, rcH, intents >>
                        ELSE /\ vpnWanted' = FALSE
                             /\ intents' = Append(intents, "STOP")
                             /\ rcE' = FALSE
                             /\ rcH' = 0
             ELSE /\ TRUE
                  /\ UNCHANGED << vpnWanted, rcH, rcT, rcE, intents >>
       /\ pc' = [pc EXCEPT ![1000] = "PRe"]
       /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                       sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                       bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
                       nInst, instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, 
                       sGen, casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                       lastJob, nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                       jRetry, jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, 
                       ui, uiSess, sessLive, gen, handler, pollOn, pollDue, 
                       pollStale, pollGen, netRestore, netGen, net, gw, faults, 
                       starts, discs, badTicks, prepAfterShut, staleStop, 
                       boundHit, stack, ps, pprev, tun, as, ab, ss, shI, shM, 
                       shEp, shSG, bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                       mgo >>

PRe == /\ pc[1000] = "PRe"
       /\ IF rcE
             THEN /\ rcE' = FALSE
                  /\ IF nJob < MaxJobs
                        THEN /\ jobOn' = [jobOn  EXCEPT ![nJob + 1] = TRUE]
                             /\ jKind' = [jKind  EXCEPT ![nJob + 1] = "reconn"]
                             /\ jInst' = [jInst  EXCEPT ![nJob + 1] = rcH]
                             /\ jRetry' = [jRetry EXCEPT ![nJob + 1] = TRUE]
                             /\ jEp' = [jEp    EXCEPT ![nJob + 1] = ep[rcH]]
                             /\ jPrev' = [jPrev  EXCEPT ![nJob + 1] = (IF Mut("Serial") THEN startJob[rcH] ELSE lastJob)]
                             /\ startJob' = [startJob EXCEPT ![rcH] = nJob + 1]
                             /\ lastJob' = nJob + 1
                             /\ nJob' = nJob + 1
                             /\ UNCHANGED boundHit
                        ELSE /\ boundHit' = TRUE
                             /\ UNCHANGED << startJob, lastJob, nJob, jobOn, 
                                             jKind, jInst, jEp, jRetry, jPrev >>
             ELSE /\ TRUE
                  /\ UNCHANGED << startJob, lastJob, nJob, jobOn, jKind, jInst, 
                                  jEp, jRetry, jPrev, rcE, boundHit >>
       /\ rcH' = 0
       /\ pc' = [pc EXCEPT ![1000] = "PL"]
       /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                       sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, 
                       bTun, cbSt, ret, nTun, tunKind, androidOpen, osCur, 
