Abandon(self) == /\ pc[self] = "Abandon"
                 /\ staleStop' = (staleStop \/ (~Mut("F2") /\ eCur # 0 /\ sOwner[eCur] > self))
                 /\ IF Mut("F2")
                       THEN /\ TRUE
                            /\ pc' = [pc EXCEPT ![self] = "AbShut"]
                            /\ UNCHANGED << stack, ss >>
                       ELSE /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Stop",
                                                                     pc        |->  "AbShut",
                                                                     ss        |->  ss[self] ] >>
                                                                 \o stack[self]]
                            /\ ss' = [ss EXCEPT ![self] = 0]
                            /\ pc' = [pc EXCEPT ![self] = "S1"]
                 /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                 sCanc, sClient, sBr, sProven, sOwner, gcPend, 
                                 nBr, bSt, bCb, bSess, bTun, cbSt, ret, nTun, 
