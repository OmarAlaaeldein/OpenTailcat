                              pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                              perm, psnap, pg, nsnap, nok, ng, it, mi, mgo >>

PrepCall(self) == /\ pc[self] = "PrepCall"
                  /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Prepare",
                                                           pc        |->  "PrepRet",
                                                           ps        |->  ps[self],
                                                           pprev     |->  pprev[self] ] >>
                                                       \o stack[self]]
                  /\ ps' = [ps EXCEPT ![self] = 0]
                  /\ pprev' = [pprev EXCEPT ![self] = 0]
                  /\ pc' = [pc EXCEPT ![self] = "P1"]
                  /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                  sCanc, sClient, sBr, sProven, sOwner, gcPend, 
                                  nBr, bSt, bCb, bSess, bTun, cbSt, ret, nTun, 
                                  tunKind, androidOpen, osCur, nInst, instUp, 
                                  shut, ep, vpnIf, startJob, sdReq, sdGen, 
                                  sGen, casGen, doneGen, finReq, dReq, nsRun, 
                                  pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                  jKind, jInst, jEp, jRetry, jPrev, jExc, jW, 
                                  jWown, jR, jRown, jSnapSess, ui, uiSess, 
                                  sessLive, gen, handler, vpnWanted, pollOn, 
                                  pollDue, pollStale, pollGen, rcH, rcT, rcE, 
                                  netRestore, netGen, intents, net, gw, faults, 
                                  starts, discs, badTicks, prepAfterShut, 
                                  staleStop, boundHit, tun, as, ab, ss, shI, 
                                  shM, shEp, shSG, bx, perm, psnap, pg, nsnap, 
                                  nok, ng, it, mi, mgo >>

PrepRet(self) == /\ pc[self] = "PrepRet"
                 /\ IF ret[self] = "err"
                       THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                            /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                            /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                            /\ jExc' = [jExc EXCEPT ![self] = "err"]
                            /\ pc' = [pc EXCEPT ![self] = "Catch"]
                       ELSE /\ IF Cancelled(self)
                                  THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                       /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                       /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                       /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                                       /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                  ELSE /\ pc' = [pc EXCEPT ![self] = "WarmEst"]
                                       /\ UNCHANGED << androidOpen, jExc, 
                                                       jWown, jRown >>
                 /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                 sCanc, sClient, sBr, sProven, sOwner, gcPend, 
                                 nBr, bSt, bCb, bSess, bTun, cbSt, ret, nTun, 
                                 tunKind, osCur, nInst, instUp, shut, ep, 
                                 vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                                 doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                                 nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                                 jRetry, jPrev, jW, jR, jSnapSess, ui, uiSess, 
                                 sessLive, gen, handler, vpnWanted, pollOn, 
                                 pollDue, pollStale, pollGen, rcH, rcT, rcE, 
                                 netRestore, netGen, intents, net, gw, faults, 
                                 starts, discs, badTicks, prepAfterShut, 
                                 staleStop, boundHit, stack, ps, pprev, tun, 
                                 as, ab, ss, shI, shM, shEp, shSG, bx, perm, 
                                 psnap, pg, nsnap, nok, ng, it, mi, mgo >>

WarmEst(self) == /\ pc[self] = "WarmEst"
                 /\ IF Mut("F3a")
                       THEN /\ IF nTun < MaxTun
                                  THEN /\ tunKind' = [tunKind EXCEPT ![nTun + 1] = "warm"]
                                       /\ androidOpen' = [androidOpen EXCEPT ![nTun + 1] = TRUE]
                                       /\ osCur' = nTun + 1
                                       /\ jW' = [jW EXCEPT ![self] = nTun + 1]
                                       /\ jWown' = [jWown EXCEPT ![self] = TRUE]
                                       /\ nTun' = nTun + 1
                                       /\ pc' = [pc EXCEPT ![self] = "WarmAdopt"]
                                       /\ UNCHANGED << jExc, jRown, boundHit >>
                                  ELSE /\ boundHit' = TRUE
                                       /\ androidOpen' = CloseOwned(androidOpen, self)
                                       /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                       /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                       /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                       /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                       /\ UNCHANGED << nTun, tunKind, osCur, 
                                                       jW >>
                            /\ vpnIf' = vpnIf
                       ELSE /\ IF Stale(self)
                                  THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                       /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                       /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                       /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                                       /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                       /\ UNCHANGED << nTun, tunKind, osCur, 
                                                       vpnIf, jW, boundHit >>
                                  ELSE /\ IF nTun < MaxTun
                                             THEN /\ tunKind' = [tunKind EXCEPT ![nTun + 1] = "warm"]
                                                  /\ androidOpen' = [androidOpen EXCEPT ![nTun + 1] = TRUE]
                                                  /\ osCur' = nTun + 1
                                                  /\ jW' = [jW EXCEPT ![self] = nTun + 1]
                                                  /\ vpnIf' = [vpnIf EXCEPT ![jInst[self]] = nTun + 1]
                                                  /\ nTun' = nTun + 1
                                                  /\ pc' = [pc EXCEPT ![self] = "WarmAdopt"]
                                                  /\ UNCHANGED << jExc, jWown, 
                                                                  jRown, 
                                                                  boundHit >>
                                             ELSE /\ boundHit' = TRUE
                                                  /\ androidOpen' = CloseOwned(androidOpen, self)
                                                  /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                                  /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                                  /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                                  /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                                  /\ UNCHANGED << nTun, 
                                                                  tunKind, 
                                                                  osCur, vpnIf, 
                                                                  jW >>
                 /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                 sCanc, sClient, sBr, sProven, sOwner, gcPend, 
                                 nBr, bSt, bCb, bSess, bTun, cbSt, ret, nInst, 
                                 instUp, shut, ep, startJob, sdReq, sdGen, 
                                 sGen, casGen, doneGen, finReq, dReq, nsRun, 
                                 pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                 jKind, jInst, jEp, jRetry, jPrev, jR, 
                                 jSnapSess, ui, uiSess, sessLive, gen, handler, 
                                 vpnWanted, pollOn, pollDue, pollStale, 
                                 pollGen, rcH, rcT, rcE, netRestore, netGen, 
                                 intents, net, gw, faults, starts, discs, 
                                 badTicks, prepAfterShut, staleStop, stack, ps, 
                                 pprev, tun, as, ab, ss, shI, shM, shEp, shSG, 
                                 bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                                 mgo >>

WarmAdopt(self) == /\ pc[self] = "WarmAdopt"
                   /\ IF Mut("F3a")
                         THEN /\ IF shut[jInst[self]]
                                    THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                         /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                         /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                         /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                                         /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                         /\ vpnIf' = vpnIf
                                    ELSE /\ vpnIf' = [vpnIf EXCEPT ![jInst[self]] = jW[self]]
                                         /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                         /\ pc' = [pc EXCEPT ![self] = "WarmAttach"]
                                         /\ UNCHANGED << androidOpen, jExc, 
                                                         jRown >>
                         ELSE /\ pc' = [pc EXCEPT ![self] = "WarmAttach"]
                              /\ UNCHANGED << androidOpen, vpnIf, jExc, jWown, 
                                              jRown >>
                   /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                   sCanc, sClient, sBr, sProven, sOwner, 
                                   gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                   ret, nTun, tunKind, osCur, nInst, instUp, 
                                   shut, ep, startJob, sdReq, sdGen, sGen, 
                                   casGen, doneGen, finReq, dReq, nsRun, 
                                   pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                   jKind, jInst, jEp, jRetry, jPrev, jW, jR, 
                                   jSnapSess, ui, uiSess, sessLive, gen, 
                                   handler, vpnWanted, pollOn, pollDue, 
                                   pollStale, pollGen, rcH, rcT, rcE, 
                                   netRestore, netGen, intents, net, gw, 
                                   faults, starts, discs, badTicks, 
                                   prepAfterShut, staleStop, boundHit, stack, 
                                   ps, pprev, tun, as, ab, ss, shI, shM, shEp, 
                                   shSG, bx, perm, psnap, pg, nsnap, nok, ng, 
                                   it, mi, mgo >>

WarmAttach(self) == /\ pc[self] = "WarmAttach"
                    /\ IF Cancelled(self)
                          THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                               /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                               /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                               /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                               /\ pc' = [pc EXCEPT ![self] = "Catch"]
                               /\ UNCHANGED << stack, tun, as, ab >>
                          ELSE /\ /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "AttachTun",
                                                                           pc        |->  "WarmAttachRet",
                                                                           as        |->  as[self],
                                                                           ab        |->  ab[self],
                                                                           tun       |->  tun[self] ] >>
                                                                       \o stack[self]]
                                  /\ tun' = [tun EXCEPT ![self] = jW[self]]
                               /\ as' = [as EXCEPT ![self] = 0]
                               /\ ab' = [ab EXCEPT ![self] = 0]
                               /\ pc' = [pc EXCEPT ![self] = "A1"]
                               /\ UNCHANGED << androidOpen, jExc, jWown, jRown >>
                    /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                    sCanc, sClient, sBr, sProven, sOwner, 
                                    gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                    ret, nTun, tunKind, osCur, nInst, instUp, 
                                    shut, ep, vpnIf, startJob, sdReq, sdGen, 
                                    sGen, casGen, doneGen, finReq, dReq, nsRun, 
                                    pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                    jKind, jInst, jEp, jRetry, jPrev, jW, jR, 
                                    jSnapSess, ui, uiSess, sessLive, gen, 
                                    handler, vpnWanted, pollOn, pollDue, 
                                    pollStale, pollGen, rcH, rcT, rcE, 
                                    netRestore, netGen, intents, net, gw, 
                                    faults, starts, discs, badTicks, 
                                    prepAfterShut, staleStop, boundHit, ps, 
                                    pprev, ss, shI, shM, shEp, shSG, bx, perm, 
                                    psnap, pg, nsnap, nok, ng, it, mi, mgo >>

WarmAttachRet(self) == /\ pc[self] = "WarmAttachRet"
                       /\ IF ret[self] = "err"
                             THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                  /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                  /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                  /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                  /\ pc' = [pc EXCEPT ![self] = "Catch"]
                             ELSE /\ pc' = [pc EXCEPT ![self] = "WarmSnap"]
                                  /\ UNCHANGED << androidOpen, jExc, jWown, 
                                                  jRown >>
                       /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                       sCanc, sClient, sBr, sProven, sOwner, 
                                       gcPend, nBr, bSt, bCb, bSess, bTun, 
                                       cbSt, ret, nTun, tunKind, osCur, nInst, 
                                       instUp, shut, ep, vpnIf, startJob, 
                                       sdReq, sdGen, sGen, casGen, doneGen, 
                                       finReq, dReq, nsRun, pendNS, lastJob, 
                                       nJob, jobOn, jDone, jCanc, jKind, jInst, 
                                       jEp, jRetry, jPrev, jW, jR, jSnapSess, 
                                       ui, uiSess, sessLive, gen, handler, 
                                       vpnWanted, pollOn, pollDue, pollStale, 
                                       pollGen, rcH, rcT, rcE, netRestore, 
                                       netGen, intents, net, gw, faults, 
                                       starts, discs, badTicks, prepAfterShut, 
                                       staleStop, boundHit, stack, ps, pprev, 
                                       tun, as, ab, ss, shI, shM, shEp, shSG, 
                                       bx, perm, psnap, pg, nsnap, nok, ng, it, 
                                       mi, mgo >>

WarmSnap(self) == /\ pc[self] = "WarmSnap"
                  /\ IF ~LiveSnap(Snap)
                        THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                             /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                             /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                             /\ jExc' = [jExc EXCEPT ![self] = "err"]
                             /\ pc' = [pc EXCEPT ![self] = "Catch"]
                        ELSE /\ pc' = [pc EXCEPT ![self] = "Sweep1"]
                             /\ UNCHANGED << androidOpen, jExc, jWown, jRown >>
                  /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                  sCanc, sClient, sBr, sProven, sOwner, gcPend, 
                                  nBr, bSt, bCb, bSess, bTun, cbSt, ret, nTun, 
                                  tunKind, osCur, nInst, instUp, shut, ep, 
                                  vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                                  doneGen, finReq, dReq, nsRun, pendNS, 
                                  lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                                  jInst, jEp, jRetry, jPrev, jW, jR, jSnapSess, 
                                  ui, uiSess, sessLive, gen, handler, 
                                  vpnWanted, pollOn, pollDue, pollStale, 
                                  pollGen, rcH, rcT, rcE, netRestore, netGen, 
                                  intents, net, gw, faults, starts, discs, 
                                  badTicks, prepAfterShut, staleStop, boundHit, 
                                  stack, ps, pprev, tun, as, ab, ss, shI, shM, 
                                  shEp, shSG, bx, perm, psnap, pg, nsnap, nok, 
                                  ng, it, mi, mgo >>

Sweep1(self) == /\ pc[self] = "Sweep1"
                /\ IF Cancelled(self)
                      THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                           /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                           /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                           /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                           /\ pc' = [pc EXCEPT ![self] = "Catch"]
                      ELSE /\ pc' = [pc EXCEPT ![self] = "Disarm"]
                           /\ UNCHANGED << androidOpen, jExc, jWown, jRown >>
                /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                                sClient, sBr, sProven, sOwner, gcPend, nBr, 
                                bSt, bCb, bSess, bTun, cbSt, ret, nTun, 
                                tunKind, osCur, nInst, instUp, shut, ep, vpnIf, 
                                startJob, sdReq, sdGen, sGen, casGen, doneGen, 
                                finReq, dReq, nsRun, pendNS, lastJob, nJob, 
                                jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                                jPrev, jW, jR, jSnapSess, ui, uiSess, sessLive, 
                                gen, handler, vpnWanted, pollOn, pollDue, 
                                pollStale, pollGen, rcH, rcT, rcE, netRestore, 
                                netGen, intents, net, gw, faults, starts, 
                                discs, badTicks, prepAfterShut, staleStop, 
                                boundHit, stack, ps, pprev, tun, as, ab, ss, 
                                shI, shM, shEp, shSG, bx, perm, psnap, pg, 
                                nsnap, nok, ng, it, mi, mgo >>

Disarm(self) == /\ pc[self] = "Disarm"
                /\ IF eCur # 0 /\ sBr[eCur] # 0
                      THEN /\ bCb' = CbOff(bCb, sBr[eCur])
                      ELSE /\ TRUE
                           /\ bCb' = bCb
                /\ pc' = [pc EXCEPT ![self] = "Detach"]
                /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                                sClient, sBr, sProven, sOwner, gcPend, nBr, 
                                bSt, bSess, bTun, cbSt, ret, nTun, tunKind, 
                                androidOpen, osCur, nInst, instUp, shut, ep, 
                                vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                                doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                                nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                                jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                                jSnapSess, ui, uiSess, sessLive, gen, handler, 
                                vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                                rcH, rcT, rcE, netRestore, netGen, intents, 
                                net, gw, faults, starts, discs, badTicks, 
                                prepAfterShut, staleStop, boundHit, stack, ps, 
                                pprev, tun, as, ab, ss, shI, shM, shEp, shSG, 
                                bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                                mgo >>

Detach(self) == /\ pc[self] = "Detach"
                /\ IF eCur = 0
                      THEN /\ IF ~Mut("F3b")
                                 THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                      /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                      /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                      /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                      /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                 ELSE /\ pc' = [pc EXCEPT ![self] = "RoutedEst"]
                                      /\ UNCHANGED << androidOpen, jExc, jWown, 
                                                      jRown >>
                           /\ UNCHANGED << eSt, hAge, sBr, bSt, bCb >>
                      ELSE /\ IF ~(eSt \in {"RUNNING", "ATTACHING", "PREPARED"})
                                 THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                      /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                      /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                      /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                      /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                      /\ UNCHANGED << eSt, hAge, sBr, bSt, bCb >>
                                 ELSE /\ bCb' = CbOff(bCb, sBr[eCur])
                                      /\ bSt' = StopBr(bSt, sBr[eCur])
                                      /\ sBr' = [sBr EXCEPT ![eCur] = 0]
                                      /\ eSt' = "PREPARED"
                                      /\ hAge' = -1
                                      /\ pc' = [pc EXCEPT ![self] = "RoutedEst"]
                                      /\ UNCHANGED << androidOpen, jExc, jWown, 
                                                      jRown >>
                /\ UNCHANGED << eCur, stopping, disco, nSess, sCanc, sClient, 
                                sProven, sOwner, gcPend, nBr, bSess, bTun, 
                                cbSt, ret, nTun, tunKind, osCur, nInst, instUp, 
                                shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                                casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                                lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                                jInst, jEp, jRetry, jPrev, jW, jR, jSnapSess, 
                                ui, uiSess, sessLive, gen, handler, vpnWanted, 
                                pollOn, pollDue, pollStale, pollGen, rcH, rcT, 
                                rcE, netRestore, netGen, intents, net, gw, 
                                faults, starts, discs, badTicks, prepAfterShut, 
                                staleStop, boundHit, stack, ps, pprev, tun, as, 
                                ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                                pg, nsnap, nok, ng, it, mi, mgo >>

RoutedEst(self) == /\ pc[self] = "RoutedEst"
                   /\ IF Mut("F3a")
                         THEN /\ IF nTun < MaxTun
                                    THEN /\ tunKind' = [tunKind EXCEPT ![nTun + 1] = "routed"]
                                         /\ androidOpen' = [androidOpen EXCEPT ![nTun + 1] = TRUE]
                                         /\ osCur' = nTun + 1
                                         /\ jR' = [jR EXCEPT ![self] = nTun + 1]
                                         /\ jRown' = [jRown EXCEPT ![self] = TRUE]
                                         /\ nTun' = nTun + 1
                                         /\ pc' = [pc EXCEPT ![self] = "RoutedClear"]
                                         /\ UNCHANGED << jExc, jWown, boundHit >>
                                    ELSE /\ boundHit' = TRUE
                                         /\ androidOpen' = CloseOwned(androidOpen, self)
                                         /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                         /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                         /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                         /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                         /\ UNCHANGED << nTun, tunKind, osCur, 
                                                         jR >>
                              /\ vpnIf' = vpnIf
                         ELSE /\ IF Stale(self)
                                    THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                         /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                         /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                         /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                                         /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                         /\ UNCHANGED << nTun, tunKind, osCur, 
                                                         vpnIf, jR, boundHit >>
                                    ELSE /\ IF nTun < MaxTun
                                               THEN /\ tunKind' = [tunKind EXCEPT ![nTun + 1] = "routed"]
                                                    /\ androidOpen' = [androidOpen EXCEPT ![nTun + 1] = TRUE]
                                                    /\ osCur' = nTun + 1
                                                    /\ jR' = [jR EXCEPT ![self] = nTun + 1]
                                                    /\ vpnIf' = [vpnIf EXCEPT ![jInst[self]] = nTun + 1]
                                                    /\ nTun' = nTun + 1
                                                    /\ pc' = [pc EXCEPT ![self] = "RoutedClear"]
                                                    /\ UNCHANGED << jExc, 
                                                                    jWown, 
                                                                    jRown, 
                                                                    boundHit >>
                                               ELSE /\ boundHit' = TRUE
                                                    /\ androidOpen' = CloseOwned(androidOpen, self)
                                                    /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                                    /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                                    /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                                    /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                                    /\ UNCHANGED << nTun, 
                                                                    tunKind, 
                                                                    osCur, 
                                                                    vpnIf, jR >>
                   /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                   sCanc, sClient, sBr, sProven, sOwner, 
                                   gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                   ret, nInst, instUp, shut, ep, startJob, 
                                   sdReq, sdGen, sGen, casGen, doneGen, finReq, 
                                   dReq, nsRun, pendNS, lastJob, nJob, jobOn, 
                                   jDone, jCanc, jKind, jInst, jEp, jRetry, 
                                   jPrev, jW, jSnapSess, ui, uiSess, sessLive, 
                                   gen, handler, vpnWanted, pollOn, pollDue, 
                                   pollStale, pollGen, rcH, rcT, rcE, 
                                   netRestore, netGen, intents, net, gw, 
                                   faults, starts, discs, badTicks, 
                                   prepAfterShut, staleStop, stack, ps, pprev, 
                                   tun, as, ab, ss, shI, shM, shEp, shSG, bx, 
                                   perm, psnap, pg, nsnap, nok, ng, it, mi, 
                                   mgo >>

RoutedClear(self) == /\ pc[self] = "RoutedClear"
                     /\ IF vpnIf[jInst[self]] = jW[self]
                           THEN /\ vpnIf' = [vpnIf EXCEPT ![jInst[self]] = 0]
                           ELSE /\ TRUE
                                /\ vpnIf' = vpnIf
                     /\ androidOpen' = CloseT(androidOpen, jW[self])
                     /\ pc' = [pc EXCEPT ![self] = "RoutedAdopt"]
                     /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                     sCanc, sClient, sBr, sProven, sOwner, 
                                     gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                     ret, nTun, tunKind, osCur, nInst, instUp, 
                                     shut, ep, startJob, sdReq, sdGen, sGen, 
                                     casGen, doneGen, finReq, dReq, nsRun, 
                                     pendNS, lastJob, nJob, jobOn, jDone, 
                                     jCanc, jKind, jInst, jEp, jRetry, jPrev, 
                                     jExc, jW, jWown, jR, jRown, jSnapSess, ui, 
                                     uiSess, sessLive, gen, handler, vpnWanted, 
                                     pollOn, pollDue, pollStale, pollGen, rcH, 
                                     rcT, rcE, netRestore, netGen, intents, 
                                     net, gw, faults, starts, discs, badTicks, 
                                     prepAfterShut, staleStop, boundHit, stack, 
                                     ps, pprev, tun, as, ab, ss, shI, shM, 
                                     shEp, shSG, bx, perm, psnap, pg, nsnap, 
                                     nok, ng, it, mi, mgo >>

RoutedAdopt(self) == /\ pc[self] = "RoutedAdopt"
                     /\ IF Mut("F3a")
                           THEN /\ IF shut[jInst[self]]
                                      THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                           /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                           /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                           /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                                           /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                           /\ vpnIf' = vpnIf
                                      ELSE /\ vpnIf' = [vpnIf EXCEPT ![jInst[self]] = jR[self]]
                                           /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                           /\ pc' = [pc EXCEPT ![self] = "RoutedAttach"]
                                           /\ UNCHANGED << androidOpen, jExc, 
                                                           jWown >>
                           ELSE /\ pc' = [pc EXCEPT ![self] = "RoutedAttach"]
                                /\ UNCHANGED << androidOpen, vpnIf, jExc, 
                                                jWown, jRown >>
                     /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                     sCanc, sClient, sBr, sProven, sOwner, 
                                     gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                     ret, nTun, tunKind, osCur, nInst, instUp, 
                                     shut, ep, startJob, sdReq, sdGen, sGen, 
                                     casGen, doneGen, finReq, dReq, nsRun, 
                                     pendNS, lastJob, nJob, jobOn, jDone, 
                                     jCanc, jKind, jInst, jEp, jRetry, jPrev, 
                                     jW, jR, jSnapSess, ui, uiSess, sessLive, 
                                     gen, handler, vpnWanted, pollOn, pollDue, 
                                     pollStale, pollGen, rcH, rcT, rcE, 
                                     netRestore, netGen, intents, net, gw, 
                                     faults, starts, discs, badTicks, 
                                     prepAfterShut, staleStop, boundHit, stack, 
                                     ps, pprev, tun, as, ab, ss, shI, shM, 
                                     shEp, shSG, bx, perm, psnap, pg, nsnap, 
                                     nok, ng, it, mi, mgo >>

RoutedAttach(self) == /\ pc[self] = "RoutedAttach"
                      /\ IF Cancelled(self)
                            THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                 /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                 /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                 /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                                 /\ pc' = [pc EXCEPT ![self] = "Catch"]
                                 /\ UNCHANGED << stack, tun, as, ab >>
                            ELSE /\ /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "AttachTun",
                                                                             pc        |->  "RoutedAttachRet",
                                                                             as        |->  as[self],
                                                                             ab        |->  ab[self],
                                                                             tun       |->  tun[self] ] >>
                                                                         \o stack[self]]
                                    /\ tun' = [tun EXCEPT ![self] = jR[self]]
                                 /\ as' = [as EXCEPT ![self] = 0]
                                 /\ ab' = [ab EXCEPT ![self] = 0]
                                 /\ pc' = [pc EXCEPT ![self] = "A1"]
                                 /\ UNCHANGED << androidOpen, jExc, jWown, 
                                                 jRown >>
                      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                      sCanc, sClient, sBr, sProven, sOwner, 
                                      gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                      ret, nTun, tunKind, osCur, nInst, instUp, 
                                      shut, ep, vpnIf, startJob, sdReq, sdGen, 
                                      sGen, casGen, doneGen, finReq, dReq, 
                                      nsRun, pendNS, lastJob, nJob, jobOn, 
                                      jDone, jCanc, jKind, jInst, jEp, jRetry, 
                                      jPrev, jW, jR, jSnapSess, ui, uiSess, 
                                      sessLive, gen, handler, vpnWanted, 
                                      pollOn, pollDue, pollStale, pollGen, rcH, 
                                      rcT, rcE, netRestore, netGen, intents, 
                                      net, gw, faults, starts, discs, badTicks, 
                                      prepAfterShut, staleStop, boundHit, ps, 
                                      pprev, ss, shI, shM, shEp, shSG, bx, 
                                      perm, psnap, pg, nsnap, nok, ng, it, mi, 
                                      mgo >>

RoutedAttachRet(self) == /\ pc[self] = "RoutedAttachRet"
                         /\ IF ret[self] = "err"
                               THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                                    /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                                    /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                                    /\ jExc' = [jExc EXCEPT ![self] = "err"]
                                    /\ pc' = [pc EXCEPT ![self] = "Catch"]
                               ELSE /\ pc' = [pc EXCEPT ![self] = "RoutedSnap"]
                                    /\ UNCHANGED << androidOpen, jExc, jWown, 
                                                    jRown >>
                         /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, 
                                         nSess, sCanc, sClient, sBr, sProven, 
                                         sOwner, gcPend, nBr, bSt, bCb, bSess, 
                                         bTun, cbSt, ret, nTun, tunKind, osCur, 
                                         nInst, instUp, shut, ep, vpnIf, 
                                         startJob, sdReq, sdGen, sGen, casGen, 
                                         doneGen, finReq, dReq, nsRun, pendNS, 
                                         lastJob, nJob, jobOn, jDone, jCanc, 
                                         jKind, jInst, jEp, jRetry, jPrev, jW, 
                                         jR, jSnapSess, ui, uiSess, sessLive, 
                                         gen, handler, vpnWanted, pollOn, 
                                         pollDue, pollStale, pollGen, rcH, rcT, 
                                         rcE, netRestore, netGen, intents, net, 
                                         gw, faults, starts, discs, badTicks, 
                                         prepAfterShut, staleStop, boundHit, 
                                         stack, ps, pprev, tun, as, ab, ss, 
                                         shI, shM, shEp, shSG, bx, perm, psnap, 
                                         pg, nsnap, nok, ng, it, mi, mgo >>

RoutedSnap(self) == /\ pc[self] = "RoutedSnap"
                    /\ IF ~LiveSnap(Snap)
                          THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                               /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                               /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                               /\ jExc' = [jExc EXCEPT ![self] = "err"]
                               /\ pc' = [pc EXCEPT ![self] = "Catch"]
                               /\ UNCHANGED jSnapSess
                          ELSE /\ jSnapSess' = [jSnapSess EXCEPT ![self] = eCur]
                               /\ pc' = [pc EXCEPT ![self] = "PostSweep"]
                               /\ UNCHANGED << androidOpen, jExc, jWown, jRown >>
                    /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                    sCanc, sClient, sBr, sProven, sOwner, 
                                    gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                    ret, nTun, tunKind, osCur, nInst, instUp, 
                                    shut, ep, vpnIf, startJob, sdReq, sdGen, 
                                    sGen, casGen, doneGen, finReq, dReq, nsRun, 
                                    pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                    jKind, jInst, jEp, jRetry, jPrev, jW, jR, 
                                    ui, uiSess, sessLive, gen, handler, 
                                    vpnWanted, pollOn, pollDue, pollStale, 
                                    pollGen, rcH, rcT, rcE, netRestore, netGen, 
                                    intents, net, gw, faults, starts, discs, 
                                    badTicks, prepAfterShut, staleStop, 
                                    boundHit, stack, ps, pprev, tun, as, ab, 
                                    ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                                    pg, nsnap, nok, ng, it, mi, mgo >>

PostSweep(self) == /\ pc[self] = "PostSweep"
                   /\ TRUE
                   /\ pc' = [pc EXCEPT ![self] = "SetHandler"]
                   /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                   sCanc, sClient, sBr, sProven, sOwner, 
                                   gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                   ret, nTun, tunKind, androidOpen, osCur, 
                                   nInst, instUp, shut, ep, vpnIf, startJob, 
                                   sdReq, sdGen, sGen, casGen, doneGen, finReq, 
                                   dReq, nsRun, pendNS, lastJob, nJob, jobOn, 
                                   jDone, jCanc, jKind, jInst, jEp, jRetry, 
                                   jPrev, jExc, jW, jWown, jR, jRown, 
                                   jSnapSess, ui, uiSess, sessLive, gen, 
                                   handler, vpnWanted, pollOn, pollDue, 
                                   pollStale, pollGen, rcH, rcT, rcE, 
                                   netRestore, netGen, intents, net, gw, 
                                   faults, starts, discs, badTicks, 
                                   prepAfterShut, staleStop, boundHit, stack, 
                                   ps, pprev, tun, as, ab, ss, shI, shM, shEp, 
                                   shSG, bx, perm, psnap, pg, nsnap, nok, ng, 
                                   it, mi, mgo >>

SetHandler(self) == /\ pc[self] = "SetHandler"
                    /\ IF ~Mut("F5") /\ Stale(self)
                          THEN /\ androidOpen' = CloseOwned(androidOpen, self)
                               /\ jWown' = [jWown EXCEPT ![self] = FALSE]
                               /\ jRown' = [jRown EXCEPT ![self] = FALSE]
                               /\ jExc' = [jExc EXCEPT ![self] = "cancel"]
                               /\ pc' = [pc EXCEPT ![self] = "Catch"]
                               /\ UNCHANGED << ui, uiSess, sessLive, gen, 
                                               handler, pollOn, pollDue, 
                                               pollStale, pollGen >>
                          ELSE /\ handler' = jInst[self]
                               /\ ui' = "CONNECTED"
                               /\ uiSess' = jSnapSess[self]
                               /\ sessLive' = TRUE
                               /\ gen' = gen + 1
                               /\ pollGen' = gen'
                               /\ pollOn' = EnPoll
                               /\ pollDue' = EnPoll
                               /\ pollStale' = 0
                               /\ pc' = [pc EXCEPT ![self] = "JEnd"]
                               /\ UNCHANGED << androidOpen, jExc, jWown, jRown >>
                    /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                    sCanc, sClient, sBr, sProven, sOwner, 
                                    gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                    ret, nTun, tunKind, osCur, nInst, instUp, 
                                    shut, ep, vpnIf, startJob, sdReq, sdGen, 
                                    sGen, casGen, doneGen, finReq, dReq, nsRun, 
                                    pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                    jKind, jInst, jEp, jRetry, jPrev, jW, jR, 
                                    jSnapSess, vpnWanted, rcH, rcT, rcE, 
                                    netRestore, netGen, intents, net, gw, 
                                    faults, starts, discs, badTicks, 
                                    prepAfterShut, staleStop, boundHit, stack, 
                                    ps, pprev, tun, as, ab, ss, shI, shM, shEp, 
                                    shSG, bx, perm, psnap, pg, nsnap, nok, ng, 
                                    it, mi, mgo >>

Catch(self) == /\ pc[self] = "Catch"
               /\ IF jExc[self] = "cancel"
                     THEN /\ pc' = [pc EXCEPT ![self] = "Abandon"]
                     ELSE /\ IF ~Mut("F4") /\ Cancelled(self)
                                THEN /\ pc' = [pc EXCEPT ![self] = "Abandon"]
                                ELSE /\ pc' = [pc EXCEPT ![self] = "CatchPerm"]
               /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                               sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
                               bCb, bSess, bTun, cbSt, ret, nTun, tunKind, 
                               androidOpen, osCur, nInst, instUp, shut, ep, 
                               vpnIf, startJob, sdReq, sdGen, sGen, casGen, 
                               doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                               nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, 
                               jRetry, jPrev, jExc, jW, jWown, jR, jRown, 
                               jSnapSess, ui, uiSess, sessLive, gen, handler, 
                               vpnWanted, pollOn, pollDue, pollStale, pollGen, 
                               rcH, rcT, rcE, netRestore, netGen, intents, net, 
                               gw, faults, starts, discs, badTicks, 
                               prepAfterShut, staleStop, boundHit, stack, ps, 
                               pprev, tun, as, ab, ss, shI, shM, shEp, shSG, 
                               bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                               mgo >>

CatchPerm(self) == /\ pc[self] = "CatchPerm"
                   /\ \/ /\ perm' = [perm EXCEPT ![self] = TRUE]
                      \/ /\ perm' = [perm EXCEPT ![self] = FALSE]
                   /\ pc' = [pc EXCEPT ![self] = "CatchDecide"]
                   /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                   sCanc, sClient, sBr, sProven, sOwner, 
                                   gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                   ret, nTun, tunKind, androidOpen, osCur, 
                                   nInst, instUp, shut, ep, vpnIf, startJob, 
                                   sdReq, sdGen, sGen, casGen, doneGen, finReq, 
                                   dReq, nsRun, pendNS, lastJob, nJob, jobOn, 
                                   jDone, jCanc, jKind, jInst, jEp, jRetry, 
                                   jPrev, jExc, jW, jWown, jR, jRown, 
                                   jSnapSess, ui, uiSess, sessLive, gen, 
                                   handler, vpnWanted, pollOn, pollDue, 
                                   pollStale, pollGen, rcH, rcT, rcE, 
                                   netRestore, netGen, intents, net, gw, 
                                   faults, starts, discs, badTicks, 
                                   prepAfterShut, staleStop, boundHit, stack, 
                                   ps, pprev, tun, as, ab, ss, shI, shM, shEp, 
                                   shSG, bx, psnap, pg, nsnap, nok, ng, it, mi, 
                                   mgo >>

CatchDecide(self) == /\ pc[self] = "CatchDecide"
                     /\ IF ~Mut("N2") /\ ~Mut("F4") /\ Cancelled(self)
                           THEN /\ pc' = [pc EXCEPT ![self] = "Abandon"]
                                /\ UNCHANGED << ui, uiSess, sessLive, gen, 
                                                vpnWanted, pollOn >>
                           ELSE /\ IF ~jRetry[self] \/ perm[self] \/ ~vpnWanted
                                      THEN /\ vpnWanted' = FALSE
                                           /\ sessLive' = FALSE
                                           /\ gen' = gen + 1
                                           /\ pollOn' = FALSE
                                           /\ ui' = IF Mut("N1") THEN "DISCONNECTED" ELSE ui
                                           /\ uiSess' = 0
                                           /\ pc' = [pc EXCEPT ![self] = "CatchShut"]
                                      ELSE /\ pc' = [pc EXCEPT ![self] = "RetryReset"]
                                           /\ UNCHANGED << ui, uiSess, 
                                                           sessLive, gen, 
                                                           vpnWanted, pollOn >>
                     /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                     sCanc, sClient, sBr, sProven, sOwner, 
                                     gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                     ret, nTun, tunKind, androidOpen, osCur, 
                                     nInst, instUp, shut, ep, vpnIf, startJob, 
                                     sdReq, sdGen, sGen, casGen, doneGen, 
                                     finReq, dReq, nsRun, pendNS, lastJob, 
                                     nJob, jobOn, jDone, jCanc, jKind, jInst, 
                                     jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                                     jRown, jSnapSess, handler, pollDue, 
                                     pollStale, pollGen, rcH, rcT, rcE, 
                                     netRestore, netGen, intents, net, gw, 
                                     faults, starts, discs, badTicks, 
                                     prepAfterShut, staleStop, boundHit, stack, 
                                     ps, pprev, tun, as, ab, ss, shI, shM, 
                                     shEp, shSG, bx, perm, psnap, pg, nsnap, 
                                     nok, ng, it, mi, mgo >>

RetryReset(self) == /\ pc[self] = "RetryReset"
                    /\ perm' = [perm EXCEPT ![self] = FALSE]
                    /\ staleStop' = (staleStop \/ (eCur # 0 /\ sOwner[eCur] > self))
                    /\ androidOpen' = CloseT(androidOpen, vpnIf[jInst[self]])
                    /\ vpnIf' = [vpnIf EXCEPT ![jInst[self]] = 0]
                    /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Stop",
                                                             pc        |->  "RetryNotify",
                                                             ss        |->  ss[self] ] >>
                                                         \o stack[self]]
                    /\ ss' = [ss EXCEPT ![self] = 0]
                    /\ pc' = [pc EXCEPT ![self] = "S1"]
                    /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                    sCanc, sClient, sBr, sProven, sOwner, 
                                    gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                    ret, nTun, tunKind, osCur, nInst, instUp, 
                                    shut, ep, startJob, sdReq, sdGen, sGen, 
                                    casGen, doneGen, finReq, dReq, nsRun, 
                                    pendNS, lastJob, nJob, jobOn, jDone, jCanc, 
                                    jKind, jInst, jEp, jRetry, jPrev, jExc, jW, 
                                    jWown, jR, jRown, jSnapSess, ui, uiSess, 
                                    sessLive, gen, handler, vpnWanted, pollOn, 
                                    pollDue, pollStale, pollGen, rcH, rcT, rcE, 
                                    netRestore, netGen, intents, net, gw, 
                                    faults, starts, discs, badTicks, 
                                    prepAfterShut, boundHit, ps, pprev, tun, 
                                    as, ab, shI, shM, shEp, shSG, bx, psnap, 
                                    pg, nsnap, nok, ng, it, mi, mgo >>

RetryNotify(self) == /\ pc[self] = "RetryNotify"
                     /\ sessLive' = FALSE
                     /\ gen' = gen + 1
                     /\ pollOn' = FALSE
                     /\ ui' = "RECONNECTING"
                     /\ uiSess' = 0
                     /\ pc' = [pc EXCEPT ![self] = "RetryDelay"]
                     /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                     sCanc, sClient, sBr, sProven, sOwner, 
                                     gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
                                     ret, nTun, tunKind, androidOpen, osCur, 
                                     nInst, instUp, shut, ep, vpnIf, startJob, 
                                     sdReq, sdGen, sGen, casGen, doneGen, 
                                     finReq, dReq, nsRun, pendNS, lastJob, 
