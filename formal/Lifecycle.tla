                               bx, perm, psnap, pg, nsnap, nok, ng, it, mi, 
                               mgo >>

CatchShut(self) == /\ pc[self] = "CatchShut"
                   /\ /\ shEp' = [shEp EXCEPT ![self] = IF Mut("N2") THEN -1 ELSE jEp[self]]
                      /\ shI' = [shI EXCEPT ![self] = jInst[self]]
                      /\ shM' = [shM EXCEPT ![self] = "sync"]
                      /\ shSG' = [shSG EXCEPT ![self] = -1]
                      /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Shutdown",
                                                               pc        |->  "CatchEnd",
                                                               shI       |->  shI[self],
                                                               shM       |->  shM[self],
                                                               shEp      |->  shEp[self],
                                                               shSG      |->  shSG[self] ] >>
                                                           \o stack[self]]
                   /\ pc' = [pc EXCEPT ![self] = "SHc"]
                   /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                   sCanc, sClient, sBr, sProven, sOwner, 
                                   gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, 
