CatchEnd(self) == /\ pc[self] = "CatchEnd"
                  /\ pc' = [pc EXCEPT ![self] = "JEnd"]
                  /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, 
                                  sCanc, sClient, sBr, sProven, sOwner, gcPend, 
