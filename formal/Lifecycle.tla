RetryDelay2(self) == /\ pc[self] = "RetryDelay2"
                     /\ \/ /\ ~jCanc[self]
                           /\ pc' = [pc EXCEPT ![self] = "Loop"]
                        \/ /\ jCanc[self]
                           /\ pc' = [pc EXCEPT ![self] = "JEnd"]
