FNw(self) == /\ pc[self] = "FNw"
             /\ finReq[self - 500] /\ pc[3000] \in {"ML", "MG"}
             /\ finReq' = [finReq EXCEPT ![self - 500] = FALSE]
             /\ IF ~Mut("N1b") /\ sGen[self - 500] # casGen[self - 500]
                   THEN /\ TRUE
                        /\ UNCHANGED << instUp, doneGen, dReq, ui, uiSess, 
                                        sessLive, gen, pollOn >>
                   ELSE /\ doneGen' = [doneGen EXCEPT ![self - 500] = casGen[self - 500]]
                        /\ sessLive' = FALSE
                        /\ gen' = gen + 1
                        /\ pollOn' = FALSE
                        /\ ui' = "DISCONNECTED"
                        /\ uiSess' = 0
                        /\ IF Mut("N1b") \/ ~PendingStart
                              THEN /\ instUp' = [instUp EXCEPT ![self - 500] = FALSE]
                                   /\ dReq' = [dReq   EXCEPT ![self - 500] = EnOnDestroy]
                              ELSE /\ TRUE
                                   /\ UNCHANGED << instUp, dReq >>
             /\ pc' = [pc EXCEPT ![self] = "FNL"]
             /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                             sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
