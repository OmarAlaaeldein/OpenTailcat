                       pg, nsnap, ng, it, mi, mgo >>

NR3 == /\ pc[1100] = "NR3"
       /\ IF nok
             THEN /\ ui' = "CONNECTED"
                  /\ uiSess' = nsnap.sess
             ELSE /\ TRUE
                  /\ UNCHANGED << ui, uiSess >>
       /\ nok' = FALSE
       /\ nsnap' = NoSnap
       /\ pc' = [pc EXCEPT ![1100] = "NL"]
       /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
