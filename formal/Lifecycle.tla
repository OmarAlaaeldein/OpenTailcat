Tk == /\ pc[2000] = "Tk"
      /\ Timed /\ ~(pollDue /\ pollOn) /\ (UiRaces \/ pc[1000] # "PA")
      /\ hAge' = NextH
      /\ disco' = NextDisco
      /\ pollDue' = pollOn
      /\ badTicks' = (IF Unjustified(NextH) /\ ~ShutBusy
                      THEN Min(badTicks + 1, BadBound + 1) ELSE 0)
      /\ pc' = [pc EXCEPT ![2000] = "TL"]
      /\ UNCHANGED << eSt, eCur, stopping, nSess, sCanc, sClient, sBr, sProven, 
                      sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, cbSt, ret, 
                      nTun, tunKind, androidOpen, osCur, nInst, instUp, shut, 
