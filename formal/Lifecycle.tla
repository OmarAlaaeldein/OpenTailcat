                      tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                      pg, nsnap, nok, ng, it, mi, mgo >>

EE == /\ pc[4000] = "EE"
      /\ \/ /\ EnNet /\ net = "up" /\ faults < MaxFaults
            /\ faults' = faults + 1
            /\ net' = "down"
            /\ IF ui = "CONNECTED"
                  THEN /\ ui' = "RECONNECTING"
                  ELSE /\ TRUE
                       /\ ui' = ui
            /\ UNCHANGED <<netRestore, netGen, intents, gw>>
         \/ /\ net = "down"
            /\ net' = "up"
            /\ IF ui = "RECONNECTING" /\ sessLive
                  THEN /\ netRestore' = TRUE
                       /\ netGen' = gen
                  ELSE /\ TRUE
                       /\ UNCHANGED << netRestore, netGen >>
            /\ UNCHANGED <<ui, intents, gw, faults>>
         \/ /\ EnGw /\ gw = "up" /\ faults < MaxFaults
            /\ faults' = faults + 1
            /\ gw' = "down"
            /\ UNCHANGED <<ui, netRestore, netGen, intents, net>>
         \/ /\ gw = "down"
            /\ gw' = "up"
            /\ UNCHANGED <<ui, netRestore, netGen, intents, net, faults>>
         \/ /\ EnDestroy /\ (\E x \in Inst : instUp[x]) /\ faults < MaxFaults
            /\ faults' = faults + 1
            /\ intents' = Append(intents, "DESTROY")
            /\ UNCHANGED <<ui, netRestore, netGen, net, gw>>
      /\ pc' = [pc EXCEPT ![4000] = "EL"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
                      instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                      casGen, doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                      nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                      jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, uiSess, 
                      sessLive, gen, handler, vpnWanted, pollOn, pollDue, 
                      pollStale, pollGen, rcH, rcT, rcE, starts, discs, 
                      badTicks, prepAfterShut, staleStop, boundHit, stack, ps, 
                      pprev, tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, 
                      psnap, pg, nsnap, nok, ng, it, mi, mgo >>

env == EL \/ EE

UL == /\ pc[5000] = "UL"
      /\ pc' = [pc EXCEPT ![5000] = "UE"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
                      instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                      casGen, doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                      nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                      jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, ui, uiSess, 
                      sessLive, gen, handler, vpnWanted, pollOn, pollDue, 
                      pollStale, pollGen, rcH, rcT, rcE, netRestore, netGen, 
                      intents, net, gw, faults, starts, discs, badTicks, 
                      prepAfterShut, staleStop, boundHit, stack, ps, pprev, 
                      tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                      pg, nsnap, nok, ng, it, mi, mgo >>

UE == /\ pc[5000] = "UE"
      /\ \/ /\ ui = "DISCONNECTED" /\ starts < MaxStarts
            /\ starts' = starts + 1
            /\ vpnWanted' = TRUE
            /\ ui' = "CONNECTING"
            /\ uiSess' = 0
            /\ intents' = Append(intents, "USER")
            /\ UNCHANGED <<pollOn, discs>>
         \/ /\ EnRestore /\ ui = "DISCONNECTED" /\ starts < MaxStarts /\ vpnWanted
            /\ starts' = starts + 1
            /\ ui' = "CONNECTING"
            /\ uiSess' = 0
            /\ intents' = Append(intents, "AUTO")
            /\ UNCHANGED <<vpnWanted, pollOn, discs>>
         \/ /\ EnAlwaysOn /\ ui = "DISCONNECTED" /\ starts < MaxStarts
            /\ starts' = starts + 1
            /\ intents' = Append(intents, "AO")
            /\ UNCHANGED <<ui, uiSess, vpnWanted, pollOn, discs>>
         \/ /\ EnDisc /\ ui # "DISCONNECTED" /\ discs < MaxDisc
            /\ discs' = discs + 1
            /\ vpnWanted' = FALSE
            /\ pollOn' = FALSE
            /\ intents' = Append(intents, "STOP")
            /\ UNCHANGED <<ui, uiSess, starts>>
         \/ /\ EnRevoke /\ (\E x \in Inst : instUp[x]) /\ discs < MaxDisc
            /\ discs' = discs + 1
            /\ intents' = Append(intents, "REVOKE")
            /\ UNCHANGED <<ui, uiSess, vpnWanted, pollOn, starts>>
      /\ pc' = [pc EXCEPT ![5000] = "UL"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
                      instUp, shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                      casGen, doneGen, finReq, dReq, nsRun, pendNS, lastJob, 
                      nJob, jobOn, jDone, jCanc, jKind, jInst, jEp, jRetry, 
                      jPrev, jExc, jW, jWown, jR, jRown, jSnapSess, sessLive, 
                      gen, handler, pollDue, pollStale, pollGen, rcH, rcT, rcE, 
                      netRestore, netGen, net, gw, faults, badTicks, 
                      prepAfterShut, staleStop, boundHit, stack, ps, pprev, 
                      tun, as, ab, ss, shI, shM, shEp, shSG, bx, perm, psnap, 
                      pg, nsnap, nok, ng, it, mi, mgo >>

user == UL \/ UE

Next == poll \/ ncb \/ main \/ clk \/ env \/ user
           \/ (\E self \in ProcSet:  \/ Prepare(self) \/ AttachTun(self)
                                     \/ Stop(self) \/ Shutdown(self))
           \/ (\E self \in BPs: bpump(self))
           \/ (\E self \in GCs: gc(self))
           \/ (\E self \in SDs: sd(self))
           \/ (\E self \in FINs: fin(self))
           \/ (\E self \in NSs: ns(self))
           \/ (\E self \in Jobs: job(self))

Spec == /\ Init /\ [][Next]_vars
        /\ \A self \in BPs : WF_vars(bpump(self))
        /\ \A self \in GCs : WF_vars(gc(self))
        /\ \A self \in SDs : WF_vars(sd(self)) /\ WF_vars(Shutdown(self)) /\ WF_vars(Stop(self))
        /\ \A self \in FINs : WF_vars(fin(self))
        /\ \A self \in NSs : WF_vars(ns(self)) /\ WF_vars(Stop(self))
        /\ \A self \in Jobs : /\ WF_vars(job(self))
                              /\ WF_vars(Stop(self))
                              /\ WF_vars(Prepare(self))
                              /\ WF_vars(AttachTun(self))
                              /\ WF_vars(Shutdown(self))
        /\ WF_vars(poll)
        /\ WF_vars(ncb)
        /\ WF_vars(main) /\ WF_vars(Shutdown(3000)) /\ WF_vars(Stop(3000))
        /\ WF_vars(clk)

\* END TRANSLATION

(***************************************************************************)
(* Properties (see README.md "Properties checked" for the code mapping).   *)
(***************************************************************************)

TypeOK ==
  /\ eSt \in {"STOPPED","PREPARING","PREPARED","ATTACHING","RUNNING","STOPPING","FAILED"}
  /\ eCur \in 0..MaxSess
  /\ hAge \in -1..HCap
  /\ disco \in {"ok","stale","lost"}
  /\ ui \in {"DISCONNECTED","CONNECTING","CONNECTED","RECONNECTING","DEGRADED"}
  /\ \A b \in Br : bSt[b] \in {"free","new","up","dead","stopped"}
  /\ \A b \in Br : cbSt[b] \in {"none","chk","mark"}
  /\ \A c \in Callers : ret[c] \in {"none","ok","err"}
  /\ badTicks \in 0..(BadBound + 1)
  /\ faults \in 0..MaxFaults
  /\ nJob \in 0..MaxJobs /\ nInst \in 0..MaxInst /\ nTun \in 0..MaxTun
  /\ nSess \in 0..MaxSess /\ nBr \in 0..MaxBr
  /\ gen \in Nat /\ \A i \in Inst : ep[i] \in Nat

\* A finite-model bound was never hit, so no behaviour was silently cut off.
BoundsOK == ~boundHit

\* ---- Property 1: routes only for an engine that proved live pumps ---------
\* A routed TUN is "pending" while the job that created it has not yet passed
\* adoptInterface() (the shutdown check).  Finding F3 is about that window.
\* (With the F3 fix a TUN is adopted in the same step that creates it, so this
\* is only ever true under the F3a mutant.)
Pending(t) == \E j \in Jobs : jRown[j] /\ jR[j] = t

\* Any ADOPTED default route that exists while the engine has a current session
\* must belong to a session that has reached RUNNING (the warm attach) at least
\* once.  This also rules out routes while PREPARING / PREPARED-before-first-attach.
Inv1_RoutesNeedProvenSession ==
  (DefaultRoutes /\ eCur # 0 /\ ~Pending(osCur)) => sProven[eCur]

\* The step that installs the routed interface happens only with a PREPARED
\* engine whose session already proved itself.
Act1_RoutedInstallNeedsProven ==
  [][ (osCur' # osCur /\ osCur' # 0 /\ tunKind'[osCur'] = "routed")
      => (eCur # 0 /\ sProven[eCur] /\ eSt = "PREPARED") ]_vars

\* Strong form of invariant 1 (documented design gap, see README "Findings"):
\* default routes imply a live bridge on that very TUN.  Holds only outside
\* the install->attach window and after pump failure, so it is expected to fail.
Inv1_Strong_RoutesImplyLiveBridge ==
  DefaultRoutes => \E b \in Br : bTun[b] = osCur /\ bSt[b] = "up"

\* ---- Property 2: UI CONNECTED/DEGRADED => RUNNING + fresh health ----------
\* badTicks counts consecutive 1 s ticks at which the UI claimed live without
\* engine RUNNING + fresh health of the same session (outside user shutdown).
Inv2_UiLiveBounded == badTicks <= BadBound

\* ---- Property 5: stale sessions -------------------------------------------
Inv5_RunningOwnsBridge ==
  eSt = "RUNNING" =>
    /\ eCur # 0 /\ sBr[eCur] # 0
    /\ bSess[sBr[eCur]] = eCur /\ ~sCanc[eCur]
Inv5_StateHasSession ==
  eSt \in {"PREPARING","PREPARED","ATTACHING","RUNNING","FAILED"} => eCur # 0
Inv5_StoppedHasNoSession ==
  eSt \in {"STOPPED","STOPPING"} => eCur = 0
Inv5_PreparedHasClient == eSt = "PREPARED" => sClient[eCur]
Inv5_BridgeOwnedBySession == \A s \in Sess : sBr[s] # 0 => bSess[sBr[s]] = s

\* A bridge whose session is no longer current must eventually stop.
StaleBridge(b) == bSt[b] \in {"new","up","dead"} /\ bSess[b] # eCur
Live5_StaleBridgesStop == \A b \in Br : (StaleBridge(b) ~> ~StaleBridge(b))

\* ---- Property 3: failure => TUN eventually closed -------------------------
DeadOn(t) == \E b \in Br : bTun[b] = t /\ bSt[b] = "dead"

Live3_DeadPumpTunCloses == \A t \in Tun : (DeadOn(t) ~> ~TunAlive(t))

\* ---- Property 4: no deadlock, Stop terminates, Prepare after Stop proceeds
InGoCall(c) == Len(stack[c]) > 0
Live4_GoCallsReturn == \A c \in Callers : (InGoCall(c) ~> ~InGoCall(c))
Live4_StopReturns ==
  \A c \in Callers : ((InGoCall(c) /\ stack[c][1].procedure = "Stop") ~> ~InGoCall(c))
Live4_JobsNotBlocked ==
  \A j \in Jobs : (pc[j] \in {"JJoin", "JoinNS"} ~> pc[j] \notin {"JJoin", "JoinNS"})

\* ---- Property 4/6 as stability checks (cheap alternative to liveness) -------
\* Rest: nothing is in flight -- no coroutine, Go call, queued intent, posted
\* runnable, poll-thread tail or pending request.  A system that is not at rest
\* but can never move again is a deadlock; configs using NEXT NextQ let TLC's
\* deadlock check find exactly those (see README).
Rest == /\ \A j \in Jobs : ~jobOn[j] \/ jDone[j]
        /\ \A c \in Callers : stack[c] = <<>>
        /\ \A i \in Inst : ~sdReq[i] /\ ~nsRun[i] /\ ~finReq[i] /\ ~dReq[i]
        /\ \A i \in Inst : pc[100 + i] = "SDw" /\ pc[200 + i] = "NSw" /\ pc[500 + i] = "FNw"
        /\ intents = <<>> /\ ~netRestore
        /\ pc[3000] \in {"ML", "MG"}                 \* main thread idle
        /\ pc[1100] \in {"NL", "NR1"}                 \* restore coroutine idle
        /\ pc[1000] \notin {"PA", "PRc", "PRe"}       \* no poll iteration / tail in flight
        /\ ~rcT /\ ~rcE
        /\ \A b \in Br : cbSt[b] = "none"
        /\ \A s \in Sess : ~gcPend[s]
        /\ ~stopping

NextQ == Next \/ (Rest /\ UNCHANGED vars)
SpecQ == Init /\ [][NextQ]_vars

NoTun == \A t \in Tun : ~TunAlive(t)

\* At rest, a user who no longer wants the VPN has no TUN.  (Property 6.)
Inv6_RestNoTun == (Rest /\ ~vpnWanted) => NoTun

\* ... and the UI says DISCONNECTED.  Finding F5 violates this transiently (an
\* in-flight start publishes CONNECTED after shutdown finished; the poll loop
\* repairs it later, see Inv2 in the timed configs).
Inv6_RestUiDisconnected == (Rest /\ ~vpnWanted) => ui = "DISCONNECTED"

\* ... and no engine session / prepared gateway client either.  Finding F2
\* violates this one (a Prepare that starts after shutdown() already stopped
\* the engine is never stopped again).
Inv6_RestEngineStopped ==
  (Rest /\ ~vpnWanted) => (eSt = "STOPPED")

\* Safety form: nothing in flight, nobody polling, yet a TUN is still held by a
\* dead bridge.  (The temporal form below needs liveness checking.)
Inv3_RestNoDeadTun == (Rest /\ ~pollOn) => \A t \in Tun : ~(DeadOn(t) /\ TunAlive(t))

\* ---- Property 7: consistency of UI / intent / engine at rest ---------------
\* UI says CONNECTED / DEGRADED => the controller has a live session (F6: a
\* stale poll / network-restore write puts CONNECTED back after the session ended).
Inv7_RestUiLiveNeedsSession == (Rest /\ ui \in LiveUi) => sessLive

\* UI says CONNECTED / DEGRADED => the user still wants the VPN (F4 / F7: a zombie
\* job or a stale STOP intent cleared vpnWanted under a newer Connect).
Inv7_RestUiLiveNeedsWanted == (Rest /\ ui \in LiveUi) => vpnWanted

\* UI says CONNECTED / DEGRADED => the engine runs that very session.  Only
\* meaningful without a poll loop (the loop repairs a stale claim; see Inv2).
Inv7_RestUiLiveNeedsEngine ==
  (Rest /\ ui \in LiveUi /\ ~pollOn) => (eSt = "RUNNING" /\ eCur = uiSess /\ ~stopping)

\* A Connect is never silently dropped: at rest, a user who wants the VPN does
\* not see DISCONNECTED (a failure clears vpnWanted via onVpnStartFailed) and
\* nothing is stuck in CONNECTING.  Not meaningful with restoreIfWanted enabled
\* (vpnWanted && DISCONNECTED is then the legitimate "waiting to restore" state).
Inv7_RestWantedNotDisconnected == (Rest /\ vpnWanted) => ui # "DISCONNECTED"
Inv7_RestNotConnecting == Rest => ui # "CONNECTING"
\* N1b fix: an instance kept alive by stopSelf(startId) never lingers idle; at
\* rest every live instance runs a start it accepted and has not shut down.
Inv8_RestNoIdleInstance == Rest => \A x \in Inst : instUp[x] => (~shut[x] /\ sGen[x] # doneGen[x])

\* ---- Property 6: after Disconnect, quiescence (temporal form) --------------
Live6_NoTunAfterDisconnect == (~vpnWanted) ~> (NoTun \/ vpnWanted)
Live6_EngineQuiet == (~vpnWanted) ~> ((eSt = "STOPPED" /\ ~stopping) \/ vpnWanted)
Live6_UiRecovers == (~vpnWanted) ~> (ui = "DISCONNECTED" \/ vpnWanted)
\* A job began Prepare after its instance's shutdown() had finished.  With the
\* F2 fix this CAN happen (the job passed its last check just before shutdown)
\* and is then undone by abandonStaleStart's stop(); it is only a symptom under
\* the F2 mutant, where the Prepare is never undone.
Safe6_NoPrepareAfterShutdown == ~prepAfterShut

\* A stale (older) start job never stops or preempts the session of a younger one.
\* Needs launchSerializedStart: an older job finishes before a younger one runs.
Safe7_NoStopOfNewerSession == ~staleStop

=============================================================================
