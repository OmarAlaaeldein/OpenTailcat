AbShut(self) == /\ pc[self] = "AbShut"
                /\ IF Mut("F2") \/ Mut("Epoch")
                      THEN /\ /\ shEp' = [shEp EXCEPT ![self] = -1]
                              /\ shI' = [shI EXCEPT ![self] = jInst[self]]
                              /\ shM' = [shM EXCEPT ![self] = "sync"]
                              /\ shSG' = [shSG EXCEPT ![self] = -1]
                              /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Shutdown",
                                                                       pc        |->  "AbEnd",
                                                                       shI       |->  shI[self],
                                                                       shM       |->  shM[self],
                                                                       shEp      |->  shEp[self],
                                                                       shSG      |->  shSG[self] ] >>
                                                                   \o stack[self]]
                           /\ pc' = [pc EXCEPT ![self] = "SHc"]
                      ELSE /\ IF Mut("N2")
                                 THEN /\ IF ep[jInst[self]] = jEp[self]
                                            THEN /\ /\ shEp' = [shEp EXCEPT ![self] = -1]
                                                    /\ shI' = [shI EXCEPT ![self] = jInst[self]]
                                                    /\ shM' = [shM EXCEPT ![self] = "sync"]
                                                    /\ shSG' = [shSG EXCEPT ![self] = -1]
                                                    /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Shutdown",
                                                                                             pc        |->  "AbEnd",
                                                                                             shI       |->  shI[self],
                                                                                             shM       |->  shM[self],
                                                                                             shEp      |->  shEp[self],
                                                                                             shSG      |->  shSG[self] ] >>
                                                                                         \o stack[self]]
                                                 /\ pc' = [pc EXCEPT ![self] = "SHc"]
                                            ELSE /\ pc' = [pc EXCEPT ![self] = "AbEnd"]
                                                 /\ UNCHANGED << stack, shI, 
                                                                 shM, shEp, 
                                                                 shSG >>
                                 ELSE /\ /\ shEp' = [shEp EXCEPT ![self] = jEp[self]]
                                         /\ shI' = [shI EXCEPT ![self] = jInst[self]]
                                         /\ shM' = [shM EXCEPT ![self] = "sync"]
                                         /\ shSG' = [shSG EXCEPT ![self] = -1]
                                         /\ stack' = [stack EXCEPT ![self] = << [ procedure |->  "Shutdown",
                                                                                  pc        |->  "AbEnd",
                                                                                  shI       |->  shI[self],
                                                                                  shM       |->  shM[self],
                                                                                  shEp      |->  shEp[self],
                                                                                  shSG      |->  shSG[self] ] >>
                                                                              \o stack[self]]
                                      /\ pc' = [pc EXCEPT ![self] = "SHc"]
                /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                                sClient, sBr, sProven, sOwner, gcPend, nBr, 
                                bSt, bCb, bSess, bTun, cbSt, ret, nTun, 
                                tunKind, androidOpen, osCur, nInst, instUp, 
                                shut, ep, vpnIf, startJob, sdReq, sdGen, sGen, 
                                casGen, doneGen, finReq, dReq, nsRun, pendNS, 
                                lastJob, nJob, jobOn, jDone, jCanc, jKind, 
                                jInst, jEp, jRetry, jPrev, jExc, jW, jWown, jR, 
                                jRown, jSnapSess, ui, uiSess, sessLive, gen, 
                                handler, vpnWanted, pollOn, pollDue, pollStale, 
                                pollGen, rcH, rcT, rcE, netRestore, netGen, 
                                intents, net, gw, faults, starts, discs, 
                                badTicks, prepAfterShut, staleStop, boundHit, 
                                ps, pprev, tun, as, ab, ss, bx, perm, psnap, 
                                pg, nsnap, nok, ng, it, mi, mgo >>

AbEnd(self) == /\ pc[self] = "AbEnd"
               /\ pc' = [pc EXCEPT ![self] = "JEnd"]
               /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, 
                               sClient, sBr, sProven, sOwner, gcPend, nBr, bSt, 
