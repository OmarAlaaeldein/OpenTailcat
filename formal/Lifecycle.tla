MG == /\ pc[3000] = "MG"
      /\ \/ /\ intents # <<>>
            /\ it' = Head(intents)
            /\ intents' = Tail(intents)
            /\ mi' = 0
            /\ dReq' = dReq
         \/ /\ \E x \in Inst : dReq[x]
            /\ mi' = (CHOOSE x \in Inst : dReq[x])
            /\ dReq' = [dReq EXCEPT ![mi'] = FALSE]
            /\ it' = "DESTROYED"
            /\ UNCHANGED intents
      /\ pc' = [pc EXCEPT ![3000] = "MR"]
      /\ UNCHANGED << eSt, eCur, stopping, hAge, disco, nSess, sCanc, sClient, 
                      sBr, sProven, sOwner, gcPend, nBr, bSt, bCb, bSess, bTun, 
                      cbSt, ret, nTun, tunKind, androidOpen, osCur, nInst, 
